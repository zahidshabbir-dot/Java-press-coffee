{%- comment -%}
  TikTok icon (outline), drawn with currentColor.
  Accepts:
  - class: optional class for the <svg>.
{%- endcomment -%}
<svg
  {% if class != blank %}class="{{ class | escape }}"{% endif %}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M14 3v11.5a3.7 3.7 0 1 1-3.7-3.7M14 3c.3 2.6 1.9 4.3 4.5 4.6"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
