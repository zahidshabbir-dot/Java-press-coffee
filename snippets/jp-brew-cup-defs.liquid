{%- comment -%}
  Brew guide: clip path (inside of the cup) and shine gradient.
  Accepts:
  - id_suffix: unique suffix for the ids (the section id).
{%- endcomment -%}
<defs>
  <clipPath id="jp-bg-clip-{{ id_suffix }}">
    <path d="M60 99 C58 150 70 202 102 214 Q130 222 158 214 C190 202 202 150 200 99 Z"/>
  </clipPath>
  <linearGradient id="jp-bg-shine-{{ id_suffix }}" x1="0" x2="1" y1="0" y2="0">
    <stop offset="0" stop-color="#fff" stop-opacity=".0"/>
    <stop offset=".25" stop-color="#fff" stop-opacity=".38"/>
    <stop offset=".55" stop-color="#fff" stop-opacity="0"/>
    <stop offset="1" stop-color="#000" stop-opacity=".16"/>
  </linearGradient>
</defs>
