{%- comment -%}
  Account (person in circle) icon, drawn with currentColor.
  Accepts:
  - class: optional class for the <svg>.
{%- endcomment -%}
<svg
  {% if class != blank %}class="{{ class | escape }}"{% endif %}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle
    cx="12"
    cy="12"
    r="10"
    stroke="currentColor"
    stroke-width="1.8"
  />
  <circle
    cx="12"
    cy="9.5"
    r="3"
    stroke="currentColor"
    stroke-width="1.8"
  />
  <path
    d="M6.5 18.5c1.2-2.4 3.1-3.5 5.5-3.5s4.3 1.1 5.5 3.5"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
  />
</svg>
