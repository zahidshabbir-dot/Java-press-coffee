{%- comment -%}
  Brew guide: the cup illustration the game draws into.
  The script finds its parts by their data attributes (data-body, data-layers, data-stream ...).
  Accepts:
  - id_suffix: unique suffix for the clip path and gradient ids (the section id).
  - label: accessible name of the illustration.
{%- endcomment -%}
<svg class="jp-bg__svg" viewBox="0 0 280 290" role="img" aria-label="{{ label | escape }}">
  {% render 'jp-brew-cup-defs', id_suffix: id_suffix %}

  {%- comment -%} Saucer and its shadow {%- endcomment -%}
  <ellipse cx="130" cy="268" rx="108" ry="13" fill="#000" opacity=".12"/>
  <ellipse cx="130" cy="250" rx="112" ry="22" fill="#e3ddd7"/>
  <ellipse cx="130" cy="246" rx="92" ry="15" fill="#f4f1ee"/>
  <ellipse cx="130" cy="236" rx="60" ry="8" fill="#000" opacity=".16"/>

  {%- comment -%} Cup: handle, body, shine and rim {%- endcomment -%}
  <path data-handle d="M203 118 C252 108 258 190 194 196" fill="none" stroke="#fff" stroke-width="13" stroke-linecap="round"/>
  <path d="M203 118 C252 108 258 190 194 196" fill="none" stroke="#000" stroke-opacity=".12" stroke-width="13" stroke-linecap="round" stroke-dasharray="0 200 60 400"/>
  <path data-body d="M54 98 C52 152 64 208 100 224 Q130 234 160 224 C196 208 208 152 206 98 Z" fill="#fff"/>
  <path d="M54 98 C52 152 64 208 100 224 Q130 234 160 224 C196 208 208 152 206 98 Z" fill="url(#jp-bg-shine-{{ id_suffix }})"/>
  <ellipse data-rim cx="130" cy="98" rx="76" ry="16" fill="#fff"/>
  <ellipse cx="130" cy="98" rx="70" ry="12" fill="#d8d0c8"/>

  {%- comment -%} Drink inside the cup (filled by the script) {%- endcomment -%}
  <g clip-path="url(#jp-bg-clip-{{ id_suffix }})">
    <g data-layers></g>
    <ellipse data-surface cx="130" cy="150" rx="60" ry="9" fill="#fff" opacity="0"/>
    <g data-swirl opacity="0">
      <path d="M-34 0 C-34 -16 34 -16 34 0 C34 12 -20 12 -20 0 C-20 -6 14 -6 14 0" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="3" stroke-linecap="round"/>
    </g>
  </g>

  {%- comment -%} Pour stream and falling coffee / sugar {%- endcomment -%}
  <rect data-stream x="126" y="52" width="8" height="0" rx="4" opacity="0"/>
  <g data-fx></g>

  {%- comment -%} Spoon {%- endcomment -%}
  <g data-spoon opacity="0">
    <line data-spoon-line x1="200" y1="14" x2="130" y2="150" stroke="#b9bcc2" stroke-width="6" stroke-linecap="round"/>
    <ellipse data-spoon-bowl cx="130" cy="150" rx="9" ry="6" fill="#b9bcc2"/>
  </g>

  {% render 'jp-brew-pourers' %}

  {%- comment -%} Steam (shown when the drink is ready) {%- endcomment -%}
  <g class="jp-bg__steam" data-steam>
    <path d="M104 78 C92 58 116 46 104 24"/>
    <path d="M134 74 C122 52 148 42 134 18"/>
    <path d="M164 78 C152 58 176 46 164 24"/>
  </g>
</svg>
