{%- assign sid = section.id -%}

{% style %}
  .jp-ft-{{ sid }} {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text_color }};
    font-family: 'Raleway', sans-serif;
  }

  .jp-ft-{{ sid }} * {
    box-sizing: border-box;
  }

  .jp-ft-{{ sid }} a {
    color: inherit;
    text-decoration: none;
  }

  .jp-ft-{{ sid }} a:hover {
    text-decoration: underline;
  }

  .jp-ft-{{ sid }} a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .jp-ft-{{ sid }} .jp-ft__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 49px clamp(40px, 8.334vw, 120px) 20px;
  }

  .jp-ft-{{ sid }} .jp-ft__top {
    display: grid;
    grid-template-columns: minmax(0, 512px) repeat(3, minmax(0, 207px));
    justify-content: start;
    align-items: start;
  }
  /* Brand column */
  .jp-ft-{{ sid }} .jp-ft__brand {
    max-width: 378px;
  }

  .jp-ft-{{ sid }} .jp-ft__logo {
    display: block;
    margin: 0 0 12px;
    font-family: 'Comforter', 'Brush Script MT', cursive;
    font-size: 32px;
    line-height: normal;
    font-weight: 400;
    white-space: nowrap;
    color: inherit;
  }

  .jp-ft-{{ sid }} .jp-ft__logo img {
    display: block;
    height: 45px;
    width: auto;
  }

  .jp-ft-{{ sid }} .jp-ft__about {
    margin: 0 0 15px;
    font-size: 16px;
    line-height: 25px;
    font-weight: 500;
  }

  .jp-ft-{{ sid }} .jp-ft__about p {
    margin: 0;
  }

  .jp-ft-{{ sid }} .jp-ft__social {
    display: flex;
    gap: 8px;
    margin: 0 0 33px;
    padding: 0;
    list-style: none;
  }

  .jp-ft-{{ sid }} .jp-ft__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: {{ section.settings.social_box_color }};
  }

  .jp-ft-{{ sid }} .jp-ft__social img {
    display: block;
    width: 36px;
    height: 36px;
  }

  /* uploaded icons sit inside the dark box */
  .jp-ft-{{ sid }} .jp-ft__social img.jp-ft__social-custom {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  /* Link columns */
  .jp-ft-{{ sid }} .jp-ft__title {
    margin: 0 0 31px;
    font-family: inherit;
    font-size: 20px;
    line-height: 26.37px;
    font-weight: 700;
    letter-spacing: normal;
    text-transform: none;
    color: inherit;
  }

  .jp-ft-{{ sid }} .jp-ft__links {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 16px;
    line-height: 19px;
    font-weight: 400;
  }

  .jp-ft-{{ sid }} .jp-ft__links li {
    margin: 0 0 19px;
  }

  .jp-ft-{{ sid }} .jp-ft__links li:last-child {
    margin-bottom: 0;
  }
  /* Bottom bar */
  .jp-ft-{{ sid }} .jp-ft__bar {
    margin-top: 24px;
    padding-top: 15px;
    border-top: 1px solid {{ section.settings.line_color }};
    text-align: center;
    font-size: 14px;
    line-height: 16px;
    font-weight: 700;
  }

  @media (max-width: 1199px) {
    .jp-ft-{{ sid }} .jp-ft__top {
      grid-template-columns: minmax(0, 1.9fr) repeat(3, minmax(0, 1fr));
      column-gap: 24px;
    }
  }

  @media (max-width: 749px) {
    .jp-ft-{{ sid }} .jp-ft__inner {
      padding: 34px 16px 12px;
    }

    .jp-ft-{{ sid }} .jp-ft__top {
      grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
      column-gap: 0;
      row-gap: 49px;
    }

    .jp-ft-{{ sid }} .jp-ft__brand {
      grid-column: 1 / -1;
      max-width: none;
      margin-bottom: 9px;
    }

    .jp-ft-{{ sid }} .jp-ft__logo {
      margin-bottom: 15px;
    }

    .jp-ft-{{ sid }} .jp-ft__social {
      margin-bottom: 0;
    }

    .jp-ft-{{ sid }} .jp-ft__bar {
      margin: 60px 7px 0;
      padding-top: 15px;
      font-size: 12px;
    }
  }
{% endstyle %}

<footer class="jp-ft-{{ sid }}">
  <div class="jp-ft__inner">
    <div class="jp-ft__top">
      <div class="jp-ft__brand">
        <a class="jp-ft__logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: alt: section.settings.logo_text, loading: 'lazy' }}
          {%- else -%}
            {{ section.settings.logo_text }}
          {%- endif -%}
        </a>

        {%- if section.settings.about != blank -%}
          <div class="jp-ft__about">{{ section.settings.about }}</div>
        {%- endif -%}

        {%- assign socials = section.blocks | where: 'type', 'social' -%}
        {%- if socials.size > 0 -%}
          <ul class="jp-ft__social">
            {%- for block in socials -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.url | default: '#' }}" aria-label="{{ block.settings.network | capitalize }}" target="_blank" rel="noopener">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon | image_url: width: 72 | image_tag: class: 'jp-ft__social-custom', width: 20, height: 20, alt: '', loading: 'lazy' }}
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- assign columns = section.blocks | where: 'type', 'column' -%}
      {%- for block in columns -%}
        <nav class="jp-ft__col" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
          <h2 class="jp-ft__title">{{ block.settings.title }}</h2>
          <ul class="jp-ft__links">
            {%- assign rows = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for row in rows -%}
              {%- assign parts = row | strip_newlines | split: '|' -%}
              {%- assign label = parts[0] | strip -%}
              {%- if label != blank -%}
                {%- assign href = parts[1] | strip -%}
                <li>
                  {%- if href != blank -%}<a href="{{ href }}">{{ label }}</a>{%- else -%}{{ label }}{%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endfor -%}
    </div>

    {%- if section.settings.copyright != blank -%}
      <div class="jp-ft__bar">{{ section.settings.copyright }}</div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "JP Footer",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Organic Cafe" },
    { "type": "color", "id": "social_box_color", "label": "Social icon box color", "default": "#003f3a", "info": "The box behind each social icon. Uploaded icons are shown inside it." },
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "Optional. Replaces the script logo text." },
    { "type": "richtext", "id": "about", "label": "Description", "default": "<p>Our journey into coffee started in 2015 with a passion for developing the best entry level burr coffee grinder on the market.</p>" },

    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright", "label": "Copyright text", "default": "Copyright © 2023 JavaPresse. All Rights Reserved" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#075d57" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "line_color", "label": "Divider line", "default": "#478a85" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "About" },
        { "type": "textarea", "id": "links", "label": "Links", "info": "One per line: Label | /link", "default": "My Account | /account\nShipping | /policies/shipping-policy\nReturns | /policies/refund-policy\nBeyond the Bean | /pages/beyond-the-bean" }
      ]
    },
    {
      "type": "social",
      "name": "Social icon",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "network", "label": "Network", "default": "facebook", "options": [
          { "value": "facebook", "label": "Facebook" },
          { "value": "linkedin", "label": "LinkedIn" },
          { "value": "twitter", "label": "Twitter" }
        ] },
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "Upload the icon for this network. It shows inside the box." },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Footer",
      "blocks": [
        { "type": "column", "settings": { "title": "About" } },
        { "type": "column", "settings": { "title": "Company", "links": "FAQ’s | /pages/faq\nWarranty | /pages/warranty\nPrivacy Statements | /policies/privacy-policy\nTerms of Services | /policies/terms-of-service" } },
        { "type": "column", "settings": { "title": "Contact", "links": "Contact Us | /pages/contact\nPhone: (+971 1234  567)" } },
        { "type": "social", "settings": { "network": "facebook" } },
        { "type": "social", "settings": { "network": "linkedin" } },
        { "type": "social", "settings": { "network": "twitter" } }
      ]
    }
  ]
}
{% endschema %}
