{{ 'jp-footer.css' | asset_url | stylesheet_tag }}

<footer
  class="jp-ft"
  style="
    --jp-ft-bg: {{ section.settings.bg }};
    --jp-ft-text: {{ section.settings.text_color }};
    --jp-ft-social-box: {{ section.settings.social_box_color }};
    --jp-ft-line: {{ section.settings.line_color }};
  "
>
  <div class="jp-ft__inner">
    <div class="jp-ft__top">
      <div class="jp-ft__brand">
        <a class="jp-ft__logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: alt: section.settings.logo_text, loading: 'lazy' }}
          {%- else -%}
            {{ section.settings.logo_text }}
          {%- endif -%}
        </a>

        {%- if section.settings.about != blank -%}
          <div class="jp-ft__about">{{ section.settings.about }}</div>
        {%- endif -%}

        {%- assign socials = section.blocks | where: 'type', 'social' -%}
        {%- if socials.size > 0 -%}
          <ul class="jp-ft__social">
            {%- for block in socials -%}
              <li {{ block.shopify_attributes }}>
                <a
                  href="{{ block.settings.url | default: '#' }}"
                  aria-label="{{ block.settings.network | capitalize }}"
                  target="_blank"
                  rel="noopener"
                >
                  {%- if block.settings.icon != blank -%}
                    {{
                      block.settings.icon
                      | image_url: width: 72
                      | image_tag: class: 'jp-ft__social-custom', width: 20, height: 20, alt: '', loading: 'lazy'
                    }}
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- assign columns = section.blocks | where: 'type', 'column' -%}
      {%- for block in columns -%}
        <nav class="jp-ft__col" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
          <h2 class="jp-ft__title">{{ block.settings.title }}</h2>
          <ul class="jp-ft__links">
            {%- assign rows = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for row in rows -%}
              {%- assign parts = row | strip_newlines | split: '|' -%}
              {%- assign label = parts[0] | strip -%}
              {%- if label != blank -%}
                {%- assign href = parts[1] | strip -%}
                <li>
                  {%- if href != blank -%}
                    <a href="{{ href }}">{{ label }}</a>
                  {%- else -%}
                    {{ label }}
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endfor -%}
    </div>

    {%- if section.settings.copyright != blank -%}
      <div class="jp-ft__bar">{{ section.settings.copyright }}</div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "JP Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Organic Cafe"
    },
    {
      "type": "color",
      "id": "social_box_color",
      "label": "Social icon box color",
      "default": "#003f3a",
      "info": "The box behind each social icon. Uploaded icons are shown inside it."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Optional. Replaces the script logo text."
    },
    {
      "type": "richtext",
      "id": "about",
      "label": "Description",
      "default": "<p>Our journey into coffee started in 2015 with a passion for developing the best entry level burr coffee grinder on the market.</p>"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "Copyright © 2023 JavaPresse. All Rights Reserved"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#075d57"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Divider line",
      "default": "#478a85"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "About"
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links",
          "info": "One per line: Label | /link",
          "default": "My Account | /account\nShipping | /policies/shipping-policy\nReturns | /policies/refund-policy\nBeyond the Bean | /pages/beyond-the-bean"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social icon",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "network",
          "label": "Network",
          "default": "facebook",
          "options": [
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "twitter",
              "label": "Twitter"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Upload the icon for this network. It shows inside the box."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Footer",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "About"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Company",
            "links": "FAQ’s | /pages/faq\nWarranty | /pages/warranty\nPrivacy Statements | /policies/privacy-policy\nTerms of Services | /policies/terms-of-service"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Contact",
            "links": "Contact Us | /pages/contact\nPhone: (+971 1234  567)"
          }
        },
        {
          "type": "social",
          "settings": {
            "network": "facebook"
          }
        },
        {
          "type": "social",
          "settings": {
            "network": "linkedin"
          }
        },
        {
          "type": "social",
          "settings": {
            "network": "twitter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
