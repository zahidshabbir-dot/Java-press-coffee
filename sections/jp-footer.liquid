{{ 'jp-footer.css' | asset_url | stylesheet_tag }}

<footer
  class="jp-ft"
  style="
    --jp-ft-bg: {{ section.settings.bg }};
    --jp-ft-text: {{ section.settings.text_color }};
    --jp-ft-social-box: {{ section.settings.social_box_color }};
    --jp-ft-line: {{ section.settings.line_color }};
  "
>
  <div class="jp-ft__inner">
    <div class="jp-ft__top">
      <div class="jp-ft__brand">
        <a class="jp-ft__logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 400
              | image_tag: alt: section.settings.logo_text, loading: 'lazy'
            }}
          {%- else -%}
            {{ section.settings.logo_text }}
          {%- endif -%}
        </a>

        {%- if section.settings.about != blank -%}
          <div class="jp-ft__about">{{ section.settings.about }}</div>
        {%- endif -%}

        {%- assign social_blocks = section.blocks | where: 'type', 'social' -%}
        {%- if social_blocks.size > 0 -%}
          <ul class="jp-ft__social">
            {%- for block in social_blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'jp-social-link',
                  network: block.settings.network,
                  url: block.settings.url,
                  class: 'jp-ft__social-link',
                  icon_image: block.settings.icon,
                  icon_image_class: 'jp-ft__social-custom'
                %}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- assign column_blocks = section.blocks | where: 'type', 'column' -%}
      {%- for block in column_blocks -%}
        {%- assign column_menu = block.settings.menu -%}
        {%- assign use_column_menu = false -%}
        {%- if column_menu != blank and column_menu.links != empty -%}
          {%- assign use_column_menu = true -%}
        {%- endif -%}
        {%- comment -%}
          Each textarea row is "Label | /link"; a row without a link is plain text.
        {%- endcomment -%}
        {%- assign link_rows = block.settings.links | newline_to_br | split: '<br />' -%}

        {%- assign column_has_links = use_column_menu -%}
        {%- unless use_column_menu -%}
          {%- for link_row in link_rows -%}
            {%- assign link_parts = link_row | strip_newlines | split: '|' -%}
            {%- assign link_label = link_parts[0] | strip -%}
            {%- assign link_url = link_parts[1] | strip -%}
            {%- if link_label != blank and link_url != blank -%}
              {%- assign column_has_links = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}

        {%- comment -%} Only a column with links is a navigation landmark. {%- endcomment -%}
        {%- if column_has_links -%}
          <nav
            class="jp-ft__col"
            aria-label="{{ block.settings.title | escape }}"
            {{ block.shopify_attributes }}
          >
        {%- else -%}
          <div class="jp-ft__col" {{ block.shopify_attributes }}>
        {%- endif -%}
          <h2 class="jp-ft__title">{{ block.settings.title }}</h2>
          <ul class="jp-ft__links">
            {%- if use_column_menu -%}
              {%- for link in column_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- for link_row in link_rows -%}
                {%- assign link_parts = link_row | strip_newlines | split: '|' -%}
                {%- assign link_label = link_parts[0] | strip -%}
                {%- if link_label != blank -%}
                  {%- assign link_url = link_parts[1] | strip -%}
                  <li>
                    {%- if link_url != blank -%}
                      <a href="{{ link_url }}">{{ link_label }}</a>
                    {%- else -%}
                      {{ link_label }}
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        {%- if column_has_links -%}
          </nav>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="jp-ft__bar">
      {%- if section.settings.copyright != blank -%}
        {{ section.settings.copyright }}
      {%- else -%}
        © {{ 'now' | date: '%Y' }} {{ shop.name }}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "JP Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Optional. If empty, the logo text is shown."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Organic Cafe",
      "info": "Also used as the logo image's alt text."
    },
    {
      "type": "richtext",
      "id": "about",
      "label": "Description",
      "default": "<p>Our journey into coffee started in 2015 with a passion for developing the best entry level burr coffee grinder on the market.</p>"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "info": "If empty, shows © with the current year and the store name."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#075d57"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "social_box_color",
      "label": "Social icon box color",
      "default": "#003f3a",
      "info": "The box behind each social icon."
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Divider line",
      "default": "#478a85"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "About"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Optional. When chosen, its links are shown instead of the list below."
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links",
          "info": "Used when no menu is chosen. One per line: Label | /link. Leave out \"| /link\" to show plain text.",
          "default": "My Account | /account\nShipping | /policies/shipping-policy\nReturns | /policies/refund-policy\nBeyond the Bean | /pages/beyond-the-bean"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social icon",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "network",
          "label": "Network",
          "default": "facebook",
          "options": [
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "twitter",
              "label": "X (Twitter)"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Optional. Replaces the built-in icon for this network; shown inside the box."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "If empty, the icon shows without a link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Footer",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "About"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Company",
            "links": "FAQs | /pages/faq\nWarranty | /pages/warranty\nPrivacy Statements | /policies/privacy-policy\nTerms of Service | /policies/terms-of-service"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Contact",
            "links": "Contact Us | /pages/contact\nPhone: (+971 1234 567)"
          }
        },
        {
          "type": "social",
          "settings": {
            "network": "facebook"
          }
        },
        {
          "type": "social",
          "settings": {
            "network": "linkedin"
          }
        },
        {
          "type": "social",
          "settings": {
            "network": "twitter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
