{% style %}
  .wr-cc-{{ section.id }} { background:{{ section.settings.bg }}; font-family:'Instrument Sans',sans-serif; padding:40px 0 60px; }
  .wr-cc-{{ section.id }} * { box-sizing:border-box; }
  .wr-cc-{{ section.id }} .wr-cc__inner { max-width:1360px; margin:0 auto; padding:0 40px; }
  .wr-cc-{{ section.id }} .wr-cc__head { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; }
  .wr-cc-{{ section.id }} .wr-cc__eyebrow { margin:0; font-size:14px; line-height:normal; font-weight:600; color:#2f6b3a; }
  .wr-cc-{{ section.id }} .wr-cc__title { margin:0; padding-top:4px; font-size:40px; line-height:44px; font-weight:600; color:#1a1a1a; letter-spacing:-0.5px; }
  .wr-cc-{{ section.id }} .wr-cc__arrows { display:flex; gap:12px; flex:0 0 auto; }
  .wr-cc-{{ section.id }} .wr-cc__arrow { width:48px; height:48px; border-radius:50%; border:1px solid #d9d4cb; background:transparent; color:#1a1a1a; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:opacity .2s ease; }
  .wr-cc-{{ section.id }} .wr-cc__arrow:disabled { opacity:.35; cursor:default; }
  .wr-cc-{{ section.id }} .wr-cc__arrow svg { width:18px; height:18px; }
  .wr-cc-{{ section.id }} .wr-cc__track { display:flex; gap:20px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; padding-top:32px; }
  .wr-cc-{{ section.id }} .wr-cc__track::-webkit-scrollbar { display:none; }
  .wr-cc-{{ section.id }} .wr-cc__item { flex:0 0 330px; scroll-snap-align:start; display:flex; flex-direction:column; gap:12px; }
  .wr-cc-{{ section.id }} .wr-cc__media { position:relative; aspect-ratio:9 / 16; overflow:hidden; background:#e9e4da; }
  .wr-cc-{{ section.id }} .wr-cc__media img, .wr-cc-{{ section.id }} .wr-cc__media video, .wr-cc-{{ section.id }} .wr-cc__media svg.placeholder-svg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .wr-cc-{{ section.id }} .wr-cc__play { position:absolute; right:14px; bottom:14px; width:44px; height:44px; border:0; border-radius:50%; background:rgba(255,255,255,.85); color:#1a1a1a; display:flex; align-items:center; justify-content:center; cursor:pointer; }
  .wr-cc-{{ section.id }} .wr-cc__play svg { width:16px; height:16px; }
  .wr-cc-{{ section.id }} .wr-cc__play .wr-cc__pause { display:none; }
  .wr-cc-{{ section.id }} .wr-cc__play.is-playing .wr-cc__pause { display:block; }
  .wr-cc-{{ section.id }} .wr-cc__play.is-playing .wr-cc__run { display:none; }
  .wr-cc-{{ section.id }} .wr-cc__product { display:flex; align-items:center; gap:12px; padding:12px; background:#fff; color:#1a1a1a; text-decoration:none; min-width:0; }
  .wr-cc-{{ section.id }} .wr-cc__product:hover { opacity:.85; }
  .wr-cc-{{ section.id }} .wr-cc__thumb { width:70px; height:70px; flex:0 0 70px; object-fit:cover; background:#efece6; }
  .wr-cc-{{ section.id }} .wr-cc__info { min-width:0; display:flex; flex-direction:column; gap:4px; }
  .wr-cc-{{ section.id }} .wr-cc__price { font-size:17px; line-height:normal; font-weight:700; }
  .wr-cc-{{ section.id }} .wr-cc__name { font-size:14px; line-height:18px; color:#1a1a1a; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
  @media (max-width:989px) {
    .wr-cc-{{ section.id }} .wr-cc__inner { padding:0 20px; }
    .wr-cc-{{ section.id }} .wr-cc__title { font-size:32px; line-height:36px; }
    .wr-cc-{{ section.id }} .wr-cc__item { flex-basis:270px; }
  }
  @media (max-width:749px) {
    .wr-cc-{{ section.id }} { padding:28px 0 40px; }
    .wr-cc-{{ section.id }} .wr-cc__title { font-size:28px; line-height:32px; }
    .wr-cc-{{ section.id }} .wr-cc__arrows { display:none; }
    .wr-cc-{{ section.id }} .wr-cc__item { flex-basis:72vw; }
    .wr-cc-{{ section.id }} .wr-cc__track { padding-top:24px; }
  }
{% endstyle %}

{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="wr-cc-{{ section.id }}">
  <div class="wr-cc__inner">
    <div class="wr-cc__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="wr-cc__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="wr-cc__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="wr-cc__arrows">
        <button class="wr-cc__arrow" type="button" data-dir="-1" aria-label="Previous">
          <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 3L5 9l6 6"/></svg>
        </button>
        <button class="wr-cc__arrow" type="button" data-dir="1" aria-label="Next">
          <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3l6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <div class="wr-cc__track" data-track>
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        <article class="wr-cc__item" {{ block.shopify_attributes }}>
          <div class="wr-cc__media">
            {%- if block.settings.video != blank -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.video | video_tag: image_size: '700x', loop: true, muted: true, playsinline: true, preload: 'metadata', controls: false, poster: block.settings.image | image_url: width: 700 }}
              {%- else -%}
                {{ block.settings.video | video_tag: image_size: '700x', loop: true, muted: true, playsinline: true, preload: 'metadata', controls: false }}
              {%- endif -%}
              <button class="wr-cc__play" type="button" aria-label="Play video">
                <svg class="wr-cc__run" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 2.5v11l9-5.5z"/></svg>
                <svg class="wr-cc__pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z"/></svg>
              </button>
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '330px', alt: product.title | default: '' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          {%- if product != blank -%}
            <a class="wr-cc__product" href="{{ product.url }}">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 140 | image_tag: class: 'wr-cc__thumb', loading: 'lazy', widths: '70, 140', sizes: '70px', alt: product.title }}
              {%- else -%}
                <span class="wr-cc__thumb" aria-hidden="true"></span>
              {%- endif -%}
              <span class="wr-cc__info">
                <span class="wr-cc__price">{{ product.price | money }}</span>
                <span class="wr-cc__name">{{ product.title }}</span>
              </span>
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} Play/pause and carousel arrows {%- endcomment -%}
<script>
  (function () {
    var root = document.querySelector('.wr-cc-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-track]');

    root.querySelectorAll('.wr-cc__arrow').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var step = track.querySelector('.wr-cc__item').offsetWidth + 20;
        track.scrollBy({ left: step * Number(btn.dataset.dir), behavior: 'smooth' });
      });
    });

    root.querySelectorAll('.wr-cc__play').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var video = btn.parentElement.querySelector('video');
        if (!video) return;
        if (video.paused) {
          video.controls = false;
          video.play();
          btn.classList.add('is-playing');
        } else {
          video.pause();
          btn.classList.remove('is-playing');
        }
      });
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "WR Community carousel",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Seen on real walls" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Styled by our community" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f3f0ea" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Optional. Upload a short video (MP4). Shown with a play button." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Used when there is no video. Also used as the video cover." },
        { "type": "product", "id": "product", "label": "Product", "info": "Shows the price, name and thumbnail, and links to the product page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "WR Community carousel",
      "blocks": [
        { "type": "look" },
        { "type": "look" },
        { "type": "look" },
        { "type": "look" }
      ]
    }
  ]
}
{% endschema %}
