    { "type": "color", "id": "water_color", "label": "Water", "default": "#cfe7ef" },
    { "type": "color", "id": "milk_color", "label": "Milk", "default": "#f7f1e8" },
    { "type": "color", "id": "coffee_color", "label": "Coffee", "default": "#4a2c1a" },

    { "type": "header", "content": "Style" },
