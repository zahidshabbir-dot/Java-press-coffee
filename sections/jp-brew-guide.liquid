    { "type": "color", "id": "stage_bg", "label": "Cup area background", "default": "#f1e6da" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2d2d2d" },
    { "type": "color", "id": "accent", "label": "Buttons and progress", "default": "#ef4444" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "action",
          "label": "What the visitor does",
          "options": [
            { "value": "cup", "label": "Pick a cup" },
