{%- comment -%}
  JP Brew guide
  A pop-up with an interactive "make your coffee" game. It opens when a visitor clicks any element
  with the attribute data-jp-brew-open (for example the "How to use" link on the product page).
  Steps, texts, colors and labels are all editable in the theme customizer.
  Styles: assets/jp-brew-guide.css. Script: assets/jp-brew-guide.js.
  Illustration: snippets/jp-brew-cup.liquid.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign cs = section.settings -%}
{%- capture check_icon -%}{% render 'jp-icon-check', format: 'css' %}{%- endcapture -%}

{{ 'jp-brew-guide.css' | asset_url | stylesheet_tag }}

<dialog
  class="jp-bg"
  data-jp-brew
  aria-labelledby="jp-bg-title-{{ sid }}"
  style="
    --jp-bg-panel: {{ cs.panel_bg }};
    --jp-bg-text: {{ cs.text_color }};
    --jp-bg-accent: {{ cs.accent }};
    --jp-bg-stage: {{ cs.stage_bg }};
    --jp-bg-check-icon: {{ check_icon | strip | escape }};
  "
>
  <div class="jp-bg__head">
    <div>
      <h2 class="jp-bg__title" id="jp-bg-title-{{ sid }}">{{ cs.heading }}</h2>
      {%- if cs.subheading != blank -%}
        <p class="jp-bg__sub">{{ cs.subheading }}</p>
      {%- endif -%}
    </div>
    <button type="button" class="jp-bg__close" data-close aria-label="{{ cs.close_label | escape }}">
      {% render 'jp-icon-close', class: 'jp-bg__close-icon' %}
    </button>
  </div>

  <div class="jp-bg__body">
    <div class="jp-bg__stage" data-stage>
      <div class="jp-bg__cupwrap" data-cupwrap>
        {% render 'jp-brew-cup', id_suffix: sid, label: cs.heading %}
        {% render 'jp-brew-shapes' %}
      </div>
    </div>

    <div class="jp-bg__panel">
      <div class="jp-bg__dots" data-dots aria-hidden="true"></div>
      <p class="jp-bg__step" data-step-label></p>
      <h3 class="jp-bg__h" data-step-title></h3>
      <p class="jp-bg__text" data-step-text></p>
      <div class="jp-bg__controls" data-controls></div>
      <button type="button" class="jp-bg__restart" data-restart>{{ cs.restart_label }}</button>
    </div>
  </div>

  <ol hidden>
    {%- for block in section.blocks -%}
      <li
        data-step
        data-action="{{ block.settings.action }}"
        data-title="{{ block.settings.title | escape }}"
        data-text="{{ block.settings.text | escape }}"
        {{ block.shopify_attributes }}
      ></li>
    {%- endfor -%}
  </ol>

  <script type="application/json" data-cfg>
    {
      "cups": [
        { "name": {{ cs.cup_1_name | json }}, "color": {{ cs.cup_1 | json }} },
        { "name": {{ cs.cup_2_name | json }}, "color": {{ cs.cup_2 | json }} },
        { "name": {{ cs.cup_3_name | json }}, "color": {{ cs.cup_3 | json }} }
      ],
      "water": {{ cs.water_color | json }},
      "milk": {{ cs.milk_color | json }},
      "coffee": {{ cs.coffee_color | json }},
      "preview": {{ cs.preview_in_editor | json }},
      "defaultCup": {{ cs.default_cup | json }},
      "labels": {
        "step": {{ cs.step_word | json }},
        "of": {{ cs.of_word | json }},
        "next": {{ cs.next_label | json }},
        "water": {{ cs.water_label | json }},
        "milk": {{ cs.milk_label | json }},
        "coffee": {{ cs.coffee_btn | json }},
        "sugar": {{ cs.sugar_btn | json }},
        "skip": {{ cs.skip_label | json }},
        "stir": {{ cs.stir_btn | json }},
        "readyTitle": {{ cs.ready_title | json }},
        "readyText": {{ cs.ready_text | json }}
      }
    }
  </script>
</dialog>

<script src="{{ 'jp-brew-guide.js' | asset_url }}" defer></script>

