<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

{% style %}
  .wr-ann-{{ section.id }} { background:{{ section.settings.bg }}; color:{{ section.settings.text_color }}; font-family:'Instrument Sans',sans-serif; font-size:14px; line-height:24px; }
  .wr-ann-{{ section.id }} .wr-ann__track { display:flex; height:42px; }
  .wr-ann-{{ section.id }} .wr-ann__item { flex:1 1 0; min-width:0; display:flex; align-items:center; justify-content:center; gap:6px; padding:0 10px; white-space:nowrap; border-left:1px solid rgba(255,255,255,0.15); }
  .wr-ann-{{ section.id }} .wr-ann__item:first-child { border-left:0; }
  .wr-ann-{{ section.id }} .wr-ann__item a { color:inherit; text-decoration:none; }
  .wr-ann-{{ section.id }} .wr-ann__u { text-decoration:underline; text-underline-offset:2px; }
  .wr-ann-{{ section.id }} .wr-ann__hl { color:{{ section.settings.highlight_color }}; }
  .wr-ann-{{ section.id }} .wr-ann__rating { display:block; width:101px; height:16px; flex:0 0 101px; }
  @media (max-width:749px) {
    .wr-ann-{{ section.id }} .wr-ann__track { overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
    .wr-ann-{{ section.id }} .wr-ann__track::-webkit-scrollbar { display:none; }
    .wr-ann-{{ section.id }} .wr-ann__item { flex:0 0 100%; scroll-snap-align:center; border-left:0; font-size:13px; }
  }
{% endstyle %}

<div class="wr-ann-{{ section.id }}">
  <div class="wr-ann__track">
    {%- for block in section.blocks -%}
      <div class="wr-ann__item" {{ block.shopify_attributes }}>
        {%- if block.settings.show_rating -%}
          <svg class="wr-ann__rating" viewBox="0 0 101 16" fill="none" aria-hidden="true">
            <rect x="0" y="0" width="16" height="16" rx="3" fill="#2fa89a"/>
            <path d="M4 8.2l2.6 2.6L12 5.4" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M25 1.5L26.9 5.9L31.4 6.3L28 9.4L29 14L25 11.6L21 14L22 9.4L18.6 6.3L23.1 5.9Z" fill="#2fa89a"/>
            <path d="M42 1.5L43.9 5.9L48.4 6.3L45 9.4L46 14L42 11.6L38 14L39 9.4L35.6 6.3L40.1 5.9Z" fill="#2fa89a"/>
            <path d="M59 1.5L60.9 5.9L65.4 6.3L62 9.4L63 14L59 11.6L55 14L56 9.4L52.6 6.3L57.1 5.9Z" fill="#2fa89a"/>
            <path d="M76 1.5L77.9 5.9L82.4 6.3L79 9.4L80 14L76 11.6L72 14L73 9.4L69.6 6.3L74.1 5.9Z" fill="#2fa89a"/>
            <path d="M93 1.5L94.9 5.9L99.4 6.3L96 9.4L97 14L93 11.6L89 14L90 9.4L86.6 6.3L91.1 5.9Z" fill="#e6e6e6"/>
          </svg>
        {%- endif -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
        <span class="{% if block.settings.underline %}wr-ann__u{% endif %}">{{ block.settings.before }}{% if block.settings.highlight != blank %}<span class="wr-ann__hl">{{ block.settings.highlight }}</span>{% endif %}{{ block.settings.after }}</span>
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "WR Announcement bar",
  "max_blocks": 3,
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "highlight_color", "label": "Highlight color", "default": "#fffeac" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "checkbox", "id": "show_rating", "label": "Show rating badge and stars", "default": false },
        { "type": "text", "id": "before", "label": "Text" },
        { "type": "text", "id": "highlight", "label": "Highlighted text" },
        { "type": "text", "id": "after", "label": "Text after highlight" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "underline", "label": "Underline text", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "WR Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "show_rating": true, "before": "Rated 4.8 by 810+ customers", "underline": true } },
        { "type": "message", "settings": { "before": "✦ Free shipping on all orders over ", "highlight": "$350" } },
        { "type": "message", "settings": { "before": "✦ Try 3 free samples in your actual space" } }
      ]
    }
  ]
}
{% endschema %}
