{%- assign sid = section.id -%}

{% style %}
  .jp-co-{{ sid }} {
    background: {{ section.settings.bg }};
    color: {{ section.settings.heading_color }};
    font-family: 'Raleway', sans-serif;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  .jp-co-{{ sid }} * {
    box-sizing: border-box;
  }

  .jp-co-{{ sid }} .jp-co__inner {
    max-width: 1201px;
    margin: 0 auto;
  }

  .jp-co-{{ sid }} .jp-co__title {
    margin: 0 0 40px;
    font-family: inherit;
    font-size: 32px;
    line-height: 45px;
    font-weight: 700;
    letter-spacing: normal;
    text-align: center;
    text-transform: capitalize;
    color: {{ section.settings.heading_color }};
  }

  .jp-co-{{ sid }} .jp-co__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 32px;
    row-gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jp-co-{{ sid }} .jp-co__item {
    text-align: center;
  }

  .jp-co-{{ sid }} .jp-co__icon {
    display: block;
    width: 64px;
    height: 64px;
    margin: 0 auto 17px;
    background: {{ section.settings.icon_color }};
    -webkit-mask: var(--jp-co-icon) center / contain no-repeat;
    mask: var(--jp-co-icon) center / contain no-repeat;
  }

  .jp-co-{{ sid }} .jp-co__icon--svg {
    background: none;
    -webkit-mask: none;
    mask: none;
    color: {{ section.settings.icon_color }};
  }

  .jp-co-{{ sid }} .jp-co__icon--svg svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .jp-co-{{ sid }} .jp-co__item-title {
    margin: 0 0 16px;
    font-family: inherit;
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    letter-spacing: normal;
    text-transform: capitalize;
    color: {{ section.settings.text_color }};
  }

  .jp-co-{{ sid }} .jp-co__text {
    margin: 0 auto;
    max-width: 276px;
    font-size: 14px;
    line-height: 22px;
    font-weight: 500;
    text-transform: capitalize;
    color: {{ section.settings.text_color }};
  }

  @media (max-width: 989px) {
    .jp-co-{{ sid }} .jp-co__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .jp-co-{{ sid }} {
      padding: {{ section.settings.padding_top_mobile }}px 20px {{ section.settings.padding_bottom_mobile }}px;
    }

    .jp-co-{{ sid }} .jp-co__title {
      font-size: 24px;
      line-height: 32px;
      margin-bottom: 32px;
    }

    .jp-co-{{ sid }} .jp-co__grid {
      grid-template-columns: 1fr;
      row-gap: 36px;
    }
  }
{% endstyle %}

<section class="jp-co-{{ sid }}">
  <div class="jp-co__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="jp-co__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="jp-co__grid">
      {%- for block in section.blocks -%}
        <li class="jp-co__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            {%- assign icon_url = block.settings.icon | image_url: width: 300 -%}
            <span class="jp-co__icon" style="--jp-co-icon: url('{{ icon_url }}')" role="presentation"></span>
          {%- else -%}
            <span class="jp-co__icon jp-co__icon--svg" role="presentation">{% render 'jp-callout-icon', index: forloop.index %}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="jp-co__item-title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="jp-co__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "JP Callout",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why 100,000 Coffee drinkers have switched to organicCoffee" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#075d57" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Title and text color", "default": "#eaeaea" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#ffffff", "info": "Icons are drawn in this color, using the shape of the uploaded image." },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 67 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Callout",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "Leave empty to use the default icon for this position." },
        { "type": "text", "id": "title", "label": "Title", "default": "Top 1% of the world’s coffee" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Specialty grade, single origin, and hand-picked at peak ripeness for the highest quality." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "JP Callout",
      "blocks": [
        { "type": "callout", "settings": { "title": "Top 1% of the world’s coffee", "text": "Specialty grade, single origin, and hand-picked at peak ripeness for the highest quality." } },
        { "type": "callout", "settings": { "title": "A new coffee each month", "text": "These coffees aren’t on the shelves, from Malawi to Myanmar, India to Ecuador, and more." } },
        { "type": "callout", "settings": { "title": "Roasted fresh to order", "text": "And always roasted to your preference. Maximum freshness, maximum flavor." } },
        { "type": "callout", "settings": { "title": "Delivered on your schedule", "text": "Skip or change your delivery date at any time, and set a schedule that works for you." } }
      ]
    }
  ]
}
{% endschema %}
