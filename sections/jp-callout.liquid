{{ 'jp-callout.css' | asset_url | stylesheet_tag }}

<section
  class="jp-co"
  style="
    --jp-co-bg: {{ section.settings.bg }};
    --jp-co-heading: {{ section.settings.heading_color }};
    --jp-co-text: {{ section.settings.text_color }};
    --jp-co-icon-color: {{ section.settings.icon_color }};
    --jp-co-padding-top: {{ section.settings.padding_top }}px;
    --jp-co-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jp-co-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --jp-co-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="jp-co__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="jp-co__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="jp-co__grid">
      {%- for block in section.blocks -%}
        <li class="jp-co__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            {%- assign icon_url = block.settings.icon | image_url: width: 300 -%}
            <span
              class="jp-co__icon"
              style="--jp-co-icon: url('{{ icon_url }}')"
              aria-hidden="true"
            ></span>
          {%- else -%}
            {%- assign icon_position = block.settings.icon_style -%}
            {%- if icon_position == blank or icon_position == 'auto' -%}
              {%- assign icon_position = forloop.index -%}
            {%- endif -%}
            <span class="jp-co__icon jp-co__icon--svg" aria-hidden="true">
              {% render 'jp-icon-callout', position: icon_position %}
            </span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="jp-co__item-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="jp-co__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "JP Callout",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why 100,000 Coffee drinkers have switched to OrganicCoffee"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#075d57"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title and text color",
      "default": "#eaeaea"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff",
      "info": "Color of the built-in icons. Uploaded icons are drawn in this color too, using the image as a shape."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 67
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Callout",
      "settings": [
        {
          "type": "select",
          "id": "icon_style",
          "label": "Built-in icon",
          "default": "auto",
          "options": [
            {
              "value": "auto",
              "label": "Automatic (by position)"
            },
            {
              "value": "1",
              "label": "Coffee plant"
            },
            {
              "value": "2",
              "label": "Globe"
            },
            {
              "value": "3",
              "label": "Clock and bean"
            },
            {
              "value": "4",
              "label": "Watch and bean"
            },
            {
              "value": "5",
              "label": "Star"
            },
            {
              "value": "6",
              "label": "Heart"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Optional. Replaces the built-in icon below; it is drawn in the section's icon color."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Top 1% of the world’s coffee"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Specialty grade, single origin, and hand-picked at peak ripeness for the highest quality."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "JP Callout",
      "blocks": [
        {
          "type": "callout",
          "settings": {
            "title": "Top 1% of the world’s coffee",
            "text": "Specialty grade, single origin, and hand-picked at peak ripeness for the highest quality."
          }
        },
        {
          "type": "callout",
          "settings": {
            "title": "A new coffee each month",
            "text": "These coffees aren’t on the shelves, from Malawi to Myanmar, India to Ecuador, and more."
          }
        },
        {
          "type": "callout",
          "settings": {
            "title": "Roasted fresh to order",
            "text": "And always roasted to your preference. Maximum freshness, maximum flavor."
          }
        },
        {
          "type": "callout",
          "settings": {
            "title": "Delivered on your schedule",
            "text": "Skip or change your delivery date at any time, and set a schedule that works for you."
          }
        }
      ]
    }
  ]
}
{% endschema %}
