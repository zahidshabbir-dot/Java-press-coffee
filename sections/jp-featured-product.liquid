{%- assign sid = section.id -%}
{%- assign product = section.settings.product | default: collections.all.products.first -%}

{{ 'jp-featured-product.css' | asset_url | stylesheet_tag }}

{%- capture select_icon -%}{% render 'jp-icon-caret', format: 'css' %}{%- endcapture -%}

{%- capture jp_fp_style -%}
  --jp-fp-red: {{ section.settings.accent }};
  --jp-fp-text: {{ section.settings.text_color }};
  --jp-fp-green: {{ section.settings.trust_color }};
  --jp-fp-bg: {{ section.settings.bg }};
  --jp-fp-tile: {{ section.settings.tile_bg }};
  --jp-fp-padding-top: {{ section.settings.padding_top }}px;
  --jp-fp-padding-bottom: {{ section.settings.padding_bottom }}px;
  --jp-fp-select-icon: {{ select_icon | strip | escape }};
{%- endcapture -%}

{%- if product == blank -%}
  <div class="jp-fp" style="{{ jp_fp_style | strip_newlines }}">
    <div class="jp-fp__inner">
      {%- if request.design_mode -%}
        <p>Select a product in the section settings.</p>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
  {%- assign current = product.selected_or_first_available_variant -%}
  <section
    class="jp-fp"
    style="{{ jp_fp_style | strip_newlines }}"
    data-jp-fp
    data-product-url="{{ product.url }}"
  >
    <div class="jp-fp__inner">
      <div class="jp-fp__media">
        {%- if product.featured_image != blank -%}
          {{
            product.featured_image
            | image_url: width: 1000
            | image_tag:
              class: 'jp-fp__img',
              alt: product.title,
              loading: 'lazy',
              widths: '500, 750, 1000',
              sizes: '(min-width: 990px) 50vw, 100vw'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'jp-fp__img' }}
        {%- endif -%}
        {%- if section.settings.show_badge -%}
          {%- if section.settings.badge != blank -%}
            {{
              section.settings.badge
              | image_url: width: 300
              | image_tag: class: 'jp-fp__badge', alt: '', loading: 'lazy'
            }}
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="jp-fp__info">
        {%- assign pills = section.blocks | where: 'type', 'pill' -%}
        {%- if pills.size > 0 -%}
          <div class="jp-fp__pills">
            {%- for block in pills -%}
              <span
                class="jp-fp__pill"
                style="--jp-fp-pill-bg: {{ block.settings.bg }}; --jp-fp-pill-color: {{ block.settings.color }};"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <h2 class="jp-fp__title">{{ product.title }}</h2>

        {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
        {%- if app_blocks.size > 0 -%}
          {%- for block in app_blocks -%}
            <div class="jp-fp__app">{% render block %}</div>
          {%- endfor -%}
        {%- elsif product.metafields.judgeme.badge != blank -%}
          <div class="jp-fp__rating jp-fp__rating--jm">
            {{- product.metafields.judgeme.badge -}}
          </div>
        {%- endif -%}

        <div class="jp-fp__price">
          <span class="jp-fp__now" data-jp-fp-price>{{ current.price | money }}</span>
          <s
            class="jp-fp__was"
            data-jp-fp-compare
            {% unless current.compare_at_price > current.price %}
              hidden
            {% endunless %}
          >
            {{- current.compare_at_price | money -}}
          </s>
        </div>

        <div class="jp-fp__desc">
          {%- if section.settings.description != blank -%}
            {{ section.settings.description }}
          {%- else -%}
            <p>{{ product.description | strip_html | truncatewords: section.settings.description_words }}</p>
          {%- endif -%}
        </div>

        {%- form 'product', product, class: 'jp-fp__form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-jp-fp-id>

          {%- unless product.has_only_default_variant -%}
            <div class="jp-fp__options">
              {%- for option in product.options_with_values -%}
                <div>
                  <label class="jp-fp__label" for="jp-fp-{{ sid }}-opt-{{ forloop.index }}">
                    {{- option.name -}}:
                  </label>
                  <select
                    class="jp-fp__select"
                    id="jp-fp-{{ sid }}-opt-{{ forloop.index }}"
                    data-jp-fp-option
                  >
                    {%- for value in option.values -%}
                      <option
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}
                          selected
                        {% endif %}
                      >
                        {{- value -}}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="jp-fp__buy">
            <div class="jp-fp__qty-wrap">
              <label class="jp-fp__label" for="jp-fp-{{ sid }}-qty">
                {{- section.settings.quantity_label -}}
              </label>
              <div class="jp-fp__qty">
                <button type="button" data-jp-fp-minus aria-label="Decrease quantity">−</button>
                <input
                  type="number"
                  id="jp-fp-{{ sid }}-qty"
                  name="quantity"
                  value="1"
                  min="1"
                  inputmode="numeric"
                  data-jp-fp-qty
                >
                <button type="button" data-jp-fp-plus aria-label="Increase quantity">+</button>
              </div>
            </div>
            <div class="jp-fp__cart">
              <button
                type="submit"
                class="jp-fp__btn"
                data-jp-fp-submit
                data-label="{{ section.settings.button_label | escape }}"
                data-soldout="{{ section.settings.sold_out_label | escape }}"
                {% unless current.available %}
                  disabled
                {% endunless %}
              >
                {%- if current.available -%}
                  {{ section.settings.button_label }}
                {%- else -%}
                  {{ section.settings.sold_out_label }}
                {%- endif -%}
              </button>
              {%- assign trusts = section.blocks | where: 'type', 'trust' -%}
              {%- if trusts.size > 0 -%}
                <ul class="jp-fp__trust">
                  {%- for block in trusts -%}
                    <li {{ block.shopify_attributes }}>
                      {% render 'jp-icon-check-circle' %}
                      {{ block.settings.text }}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>
        {%- endform -%}
      </div>
    </div>

    <script type="application/json" data-jp-fp-variants>
      {%- render 'jp-variants-json', product: product -%}
    </script>
  </section>

  <script src="{{ 'jp-featured-product.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "JP Featured product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty to show the first product in the store."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description override",
      "info": "Leave empty to use the product description."
    },
    {
      "type": "range",
      "id": "description_words",
      "label": "Description length (words)",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity label",
      "default": "Quantity:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Badge image",
      "info": "Upload the badge image. Nothing shows until you upload one."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tile_bg",
      "label": "Image tile background",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#424242"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color (price & button)",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "trust_color",
      "label": "Trust badges color",
      "default": "#075d57"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 82
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 110
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "pill",
      "name": "Round label",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Best Seller"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background",
          "default": "#e8dc4b"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "default": "#424242"
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust badge",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Secure Checkout"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Featured product",
      "blocks": [
        {
          "type": "pill",
          "settings": {
            "text": "Best Seller",
            "bg": "#e8dc4b",
            "color": "#424242"
          }
        },
        {
          "type": "pill",
          "settings": {
            "text": "Staff Pick",
            "bg": "#3f3f3f",
            "color": "#ffffff"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Secure Checkout"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Secure Shipping"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Satisfaction Guarantee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
