<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
{%- assign trim_pct = section.settings.trim | times: 2 -%}{%- assign zoom_den = 100 | minus: trim_pct -%}{%- assign zoom = 100.0 | divided_by: zoom_den -%}
{% style %}
  .wr-sm-{{ section.id }} { background:{{ section.settings.bg }}; font-family:'Instrument Sans',sans-serif; padding:64px 0; }
  .wr-sm-{{ section.id }} * { box-sizing:border-box; }
  .wr-sm-{{ section.id }} .wr-sm__inner { max-width:1200px; margin:0 auto; padding:0 40px; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:64px; align-items:center; }
  .wr-sm-{{ section.id }} .wr-sm__visual { position:relative; width:100%; max-width:560px; aspect-ratio:376 / 275; justify-self:center; }
  .wr-sm-{{ section.id }} .wr-sm__card { position:absolute; margin:0; padding:0; background:transparent; }
  .wr-sm-{{ section.id }} .wr-sm__card .wr-sm__img { position:relative; width:100%; background:transparent; overflow:hidden; }
  .wr-sm-{{ section.id }} .wr-sm__card img, .wr-sm-{{ section.id }} .wr-sm__card svg { display:block; width:100%; height:auto; transform:scale({{ zoom }}); transform-origin:center; }
  .wr-sm-{{ section.id }} .wr-sm__card--1 { left:8%; top:21%; width:37.5%; transform:rotate(-7deg); }
  .wr-sm-{{ section.id }} .wr-sm__card--2 { left:29.8%; top:8%; width:40.5%; z-index:2; }
  .wr-sm-{{ section.id }} .wr-sm__card--3 { left:51%; top:19%; width:38%; transform:rotate(6deg); }
  .wr-sm-{{ section.id }} .wr-sm__badge { position:absolute; z-index:3; right:8%; bottom:8%; width:clamp(64px, 17%, 92px); aspect-ratio:1; border-radius:50%; background:#000; color:#fff; display:grid; place-items:center; padding:8px; text-align:center; font-size:11.5px; line-height:1.15; font-weight:700; letter-spacing:0.4px; text-transform:uppercase; transform:rotate(-10deg); }
  .wr-sm-{{ section.id }} .wr-sm__eyebrow { margin:0 0 12px; font-size:12px; line-height:normal; font-weight:500; letter-spacing:1.5px; text-transform:uppercase; color:#444; }
  .wr-sm-{{ section.id }} .wr-sm__title { margin:0; font-family:'Instrument Sans',sans-serif; font-size:32px; line-height:1.15; font-weight:600; color:#111; text-transform:none; letter-spacing:0; }
  .wr-sm-{{ section.id }} .wr-sm__text { margin:14px 0 0; font-size:15px; line-height:1.55; color:#444; }
  .wr-sm-{{ section.id }} .wr-sm__text p { margin:0; }
  .wr-sm-{{ section.id }} .wr-sm__steps { list-style:none; margin:22px 0 0; padding:0; display:grid; gap:16px; }
  .wr-sm-{{ section.id }} .wr-sm__step { display:flex; align-items:flex-start; gap:14px; margin:0; }
  .wr-sm-{{ section.id }} .wr-sm__num { flex:0 0 28px; width:28px; height:28px; border:1px solid #111; border-radius:50%; display:grid; place-items:center; font-size:13px; font-weight:500; color:#111; margin-top:1px; }
  .wr-sm-{{ section.id }} .wr-sm__step-title { margin:0; font-size:15px; line-height:1.3; font-weight:600; color:#111; }
  .wr-sm-{{ section.id }} .wr-sm__step-text { margin:2px 0 0; font-size:13.5px; line-height:1.4; color:#6b6b6b; }
  .wr-sm-{{ section.id }} .wr-sm__btn { display:inline-flex; align-items:center; justify-content:center; margin-top:26px; padding:14px 26px; background:#000; border:1px solid #000; color:#fff; font-size:14.5px; line-height:18px; font-weight:600; text-decoration:none; }
  .wr-sm-{{ section.id }} .wr-sm__btn:hover { background:#fff; color:#000; }
  @media (max-width:989px) {
    .wr-sm-{{ section.id }} { padding:44px 0; }
    .wr-sm-{{ section.id }} .wr-sm__inner { grid-template-columns:1fr; gap:32px; padding:0 20px; }
    .wr-sm-{{ section.id }} .wr-sm__title { font-size:28px; }
  }
{% endstyle %}

<section class="wr-sm-{{ section.id }}">
  <div class="wr-sm__inner">
    <div class="wr-sm__visual">
      <figure class="wr-sm__card wr-sm__card--1"><div class="wr-sm__img">{%- if section.settings.image_1 != blank -%}{{ section.settings.image_1 | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200, 350, 500', sizes: '200px', alt: '' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div></figure>
      <figure class="wr-sm__card wr-sm__card--3"><div class="wr-sm__img">{%- if section.settings.image_3 != blank -%}{{ section.settings.image_3 | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200, 350, 500', sizes: '200px', alt: '' }}{%- else -%}{{ 'product-3' | placeholder_svg_tag }}{%- endif -%}</div></figure>
      <figure class="wr-sm__card wr-sm__card--2"><div class="wr-sm__img">{%- if section.settings.image_2 != blank -%}{{ section.settings.image_2 | image_url: width: 600 | image_tag: loading: 'lazy', widths: '250, 400, 600', sizes: '250px', alt: '' }}{%- else -%}{{ 'product-2' | placeholder_svg_tag }}{%- endif -%}</div></figure>
      {%- if section.settings.badge_text != blank -%}<span class="wr-sm__badge">{{ section.settings.badge_text }}</span>{%- endif -%}
    </div>

    <div class="wr-sm__body">
      {%- if section.settings.eyebrow != blank -%}<p class="wr-sm__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="wr-sm__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="wr-sm__text">{{ section.settings.text }}</div>{%- endif -%}
      <ol class="wr-sm__steps">
        {%- for block in section.blocks -%}
          <li class="wr-sm__step" {{ block.shopify_attributes }}>
            <span class="wr-sm__num">{{ forloop.index }}</span>
            <div><p class="wr-sm__step-title">{{ block.settings.title }}</p><p class="wr-sm__step-text">{{ block.settings.text }}</p></div>
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.button_label != blank -%}<a class="wr-sm__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WR Free samples",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Sample 1 (left)" },
    { "type": "image_picker", "id": "image_2", "label": "Sample 2 (center, front)" },
    { "type": "image_picker", "id": "image_3", "label": "Sample 3 (right)" },
    { "type": "text", "id": "badge_text", "label": "Round badge text", "default": "3 free samples" },
    { "type": "range", "id": "trim", "label": "Trim image edges", "info": "Crops a border that is part of the uploaded picture. 0 = show the whole image.", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 0 },
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Try before you commit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it on your wall before you buy a roll" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Screens can't show texture, sheen or how color shifts in your light. Order 3 free samples and decide with confidence. <strong>Join our list and sample shipping is on us.</strong></p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Order Free Samples" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f6f5f2" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pick up to 3 designs" },
        { "type": "text", "id": "text", "label": "Text", "default": "Tap \"Free Sample\" on any product." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "WR Free samples",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick up to 3 designs", "text": "Tap \"Free Sample\" on any product." } },
        { "type": "step", "settings": { "title": "Tape them up at home", "text": "Check them morning and evening, next to your furniture." } },
        { "type": "step", "settings": { "title": "Order your favorite", "text": "Use the roll calculator on PDP to get the quantity right." } }
      ]
    }
  ]
}
{% endschema %}
