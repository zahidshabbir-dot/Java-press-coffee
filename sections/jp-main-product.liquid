{%- comment -%}
  JP Product
  Product page: gallery, title, price, variant pickers, quantity, add to cart and accordions.
  Styles: assets/jp-main-product.css. Script: assets/jp-main-product.js.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign current = product.selected_or_first_available_variant -%}
{%- capture select_icon -%}{% render 'jp-icon-caret', format: 'css' %}{%- endcapture -%}

{{ 'jp-main-product.css' | asset_url | stylesheet_tag }}

<section
  class="jp-mp"
  data-jp-mp
  data-product-url="{{ product.url }}"
  style="
    --jp-mp-red: {{ section.settings.accent }};
    --jp-mp-text: {{ section.settings.text_color }};
    --jp-mp-green: {{ section.settings.trust_color }};
    --jp-mp-bg: {{ section.settings.bg }};
    --jp-mp-tile: {{ section.settings.tile_color }};
    --jp-mp-acc-bg: {{ section.settings.acc_bg }};
    --jp-mp-padding-top: {{ section.settings.padding_top }}px;
    --jp-mp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jp-mp-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --jp-mp-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --jp-mp-select-icon: {{ select_icon | strip | escape }};
  "
>
  <div class="jp-mp__inner">
    <div class="jp-mp__gallery">
      <div class="jp-mp__stage" data-jp-mp-stage>
        {%- if product.images.size > 0 -%}
          {%- for image in product.images -%}
            <div
              class="jp-mp__slide{% if forloop.first %} is-active{% endif %}{% if image.aspect_ratio >= 0.9 and section.settings.fill_photos %} is-photo{% endif %}"
              data-jp-mp-slide
              data-media-id="{{ image.id }}"
            >
              {%- assign slide_alt = image.alt | default: product.title -%}
              {%- if forloop.first -%}
                {%- assign slide_loading = 'eager' -%}
                {%- assign slide_priority = 'high' -%}
              {%- else -%}
                {%- assign slide_loading = 'lazy' -%}
                {%- assign slide_priority = 'auto' -%}
              {%- endif -%}
              {{
                image
                | image_url: width: 1000
                | image_tag:
                  alt: slide_alt,
                  loading: slide_loading,
                  fetchpriority: slide_priority,
                  widths: '400, 600, 800, 1000',
                  sizes: '(min-width: 990px) 585px, 100vw'
              }}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="jp-mp__slide is-active">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}

        {%- if product.images.size > 1 -%}
          <button type="button" class="jp-mp__arrow jp-mp__arrow--prev" aria-label="Previous image" data-jp-mp-prev>
            {% render 'jp-icon-slide-arrow', direction: 'prev' %}
          </button>
          <button type="button" class="jp-mp__arrow jp-mp__arrow--next" aria-label="Next image" data-jp-mp-next>
            {% render 'jp-icon-slide-arrow', direction: 'next' %}
          </button>
        {%- endif -%}
      </div>

      {%- if product.images.size > 0 -%}
        <ul class="jp-mp__thumbs">
          {%- for image in product.images -%}
            <li>
              <button
                type="button"
                class="jp-mp__thumb"
                data-jp-mp-thumb="{{ forloop.index0 }}"
                aria-label="Show image {{ forloop.index }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              >
                {{ image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="jp-mp__info">
      {%- assign pills = section.blocks | where: 'type', 'pill' -%}
      {%- if pills.size > 0 -%}
        <div class="jp-mp__pills">
          {%- for block in pills -%}
            <span
              class="jp-mp__pill"
              style="--jp-mp-pill-bg: {{ block.settings.bg }}; --jp-mp-pill-color: {{ block.settings.color }};"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.text -}}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <h1 class="jp-mp__title">{{ product.title }}</h1>

      {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
      {%- if app_blocks.size > 0 -%}
        {%- for block in app_blocks -%}
          <div class="jp-mp__app">{% render block %}</div>
        {%- endfor -%}
      {%- elsif product.metafields.judgeme.badge != blank -%}
        <div class="jp-mp__rating jp-mp__rating--jm">{{ product.metafields.judgeme.badge }}</div>
      {%- endif -%}

      <div class="jp-mp__price">
        <span class="jp-mp__now" data-jp-mp-price>{{ current.price | money }}</span>
        <s
          class="jp-mp__was"
          data-jp-mp-compare
          {% unless current.compare_at_price > current.price %}hidden{% endunless %}
        >
          {{- current.compare_at_price | money -}}
        </s>
      </div>

      <div class="jp-mp__desc">
        {%- if section.settings.description != blank -%}
          {{ section.settings.description }}
        {%- else -%}
          <p>{{ product.description | strip_html | truncatewords: section.settings.description_words }}</p>
        {%- endif -%}
      </div>

      {%- form 'product', product, class: 'jp-mp__form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-jp-mp-id>

        {%- unless product.has_only_default_variant -%}
          <div class="jp-mp__options">
            {%- for option in product.options_with_values -%}
              <div>
                <label class="jp-mp__label" for="jp-mp-{{ sid }}-opt-{{ forloop.index }}">{{ option.name }}:</label>
                <select class="jp-mp__select" id="jp-mp-{{ sid }}-opt-{{ forloop.index }}" data-jp-mp-option>
                  {%- for value in option.values -%}
                    <option
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}selected{% endif %}
                    >
                      {{- value -}}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <div class="jp-mp__buy">
          <div class="jp-mp__qty-wrap">
            <label class="jp-mp__label" for="jp-mp-{{ sid }}-qty">{{ section.settings.quantity_label }}</label>
            <div class="jp-mp__qty">
              <button type="button" data-jp-mp-minus aria-label="Decrease quantity">
                {%- render 'jp-icon-minus' -%}
              </button>
              <input
                type="number"
                id="jp-mp-{{ sid }}-qty"
                name="quantity"
                value="1"
                min="1"
                inputmode="numeric"
                data-jp-mp-qty
              >
              <button type="button" data-jp-mp-plus aria-label="Increase quantity">
                {%- render 'jp-icon-plus' -%}
              </button>
            </div>
          </div>

          <div class="jp-mp__cart">
            <button
              type="submit"
              class="jp-mp__btn"
              data-jp-mp-submit
              data-label="{{ section.settings.button_label | escape }}"
              data-soldout="{{ section.settings.sold_out_label | escape }}"
              {% unless current.available %}disabled{% endunless %}
            >
              {%- if current.available -%}
                {{- section.settings.button_label -}}
              {%- else -%}
                {{- section.settings.sold_out_label -}}
              {%- endif -%}
            </button>

            {%- assign trusts = section.blocks | where: 'type', 'trust' -%}
            {%- if trusts.size > 0 -%}
              <ul class="jp-mp__trust">
                {%- for block in trusts -%}
                  <li {{ block.shopify_attributes }}>
                    {% render 'jp-icon-check-circle' %}
                    {{ block.settings.text }}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endform -%}

      {%- assign accs = section.blocks | where: 'type', 'accordion' -%}
      {%- if accs.size > 0 -%}
        <div class="jp-mp__acc">
          {%- for block in accs -%}
            <details class="jp-mp__item" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
              <summary>
                <span>{{ block.settings.title }}</span>
                {% render 'jp-icon-plus', color: '#424242', stroke_width: 1.6 %}
              </summary>
              <div class="jp-mp__acc-body">
                {%- if block.settings.content != blank -%}
                  {{ block.settings.content }}
                {%- else -%}
                  {{ product.description }}
                {%- endif -%}
                {%- if block.settings.show_howto and section.settings.howto_label != blank -%}
                  <button type="button" class="jp-mp__howto" data-jp-brew-open>{{ section.settings.howto_label }}</button>
                {%- endif -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-jp-mp-variants>
    {%- render 'jp-variants-json', product: product -%}
  </script>
</section>

<script src="{{ 'jp-main-product.js' | asset_url }}" defer></script>

<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{
  "name": "JP Product",
  "settings": [
    {
      "type": "richtext",
      "id": "description",
      "label": "Short description override",
      "info": "Leave empty to use the product description."
    },
    {
      "type": "range",
      "id": "description_words",
      "label": "Description length (words)",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "fill_photos",
      "label": "Fill the image area with photos",
      "info": "Square or wide photos fill the grey area. Tall product shots (like the coffee bag) stay centered.",
      "default": true
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity label",
      "default": "Quantity:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "howto_label",
      "label": "\"How to use\" link text",
      "info": "Opens the brew guide pop-up (add the JP Brew guide section to this page). Leave empty to hide.",
      "default": "How to use"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tile_color",
      "label": "Image background",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "acc_bg",
      "label": "Accordion background",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#424242"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Price and button",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "trust_color",
      "label": "Trust text color",
      "default": "#075d57"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "pill",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Best Seller"
        },
        {
          "type": "color",
          "id": "bg",
          "label": "Background",
          "default": "#ece03a"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "default": "#434343"
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Secure Checkout"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "About Product:"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "Leave empty to use the product description."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_howto",
          "label": "Show the \"How to use\" link",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Product",
      "blocks": [
        {
          "type": "pill",
          "settings": {
            "text": "Best Seller",
            "bg": "#ece03a",
            "color": "#434343"
          }
        },
        {
          "type": "pill",
          "settings": {
            "text": "Staff Pick",
            "bg": "#424242",
            "color": "#ffffff"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Secure Checkout"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Secure Shipping"
          }
        },
        {
          "type": "trust",
          "settings": {
            "text": "Satisfaction Guarantee"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "About Product:",
            "open": true,
            "show_howto": true
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Ingredients:"
          }
        }
      ]
    }
  ]
}
{% endschema %}
