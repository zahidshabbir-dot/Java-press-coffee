<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

{% style %}
  .wr-nl-{{ section.id }} { background:{{ section.settings.bg }}; color:{{ section.settings.text_color }}; font-family:'Instrument Sans',sans-serif; padding:36px 0 32px; }
  .wr-nl-{{ section.id }} * { box-sizing:border-box; }
  .wr-nl-{{ section.id }} .wr-nl__inner { max-width:1440px; margin:0 auto; padding:0 44px; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:40px; align-items:center; }
  .wr-nl-{{ section.id }} .wr-nl__kicker { margin:0 0 6px; font-size:17px; line-height:normal; font-weight:500; color:inherit; }
  .wr-nl-{{ section.id }} .wr-nl__title { margin:0; max-width:560px; font-family:'Instrument Sans',sans-serif; font-size:40px; line-height:1.02; font-weight:600; color:inherit; text-transform:none; letter-spacing:0; }
  .wr-nl-{{ section.id }} .wr-nl__text { margin:14px 0 0; font-size:12.5px; line-height:1.5; color:inherit; opacity:0.85; }
  .wr-nl-{{ section.id }} .wr-nl__form { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin:0; }
  .wr-nl-{{ section.id }} .wr-nl__form input[type=email] { width:300px; max-width:100%; height:44px; padding:0 16px; border:1px solid rgba(255,255,255,0.7); border-radius:10px; background:transparent; color:#fff; font-family:inherit; font-size:15px; }
  .wr-nl-{{ section.id }} .wr-nl__form input[type=email]::placeholder { color:rgba(255,255,255,0.75); }
  .wr-nl-{{ section.id }} .wr-nl__form input[type=email]:focus { outline:2px solid #fff; outline-offset:2px; }
  .wr-nl-{{ section.id }} .wr-nl__btn { height:44px; padding:0 24px; border:0; border-radius:10px; background:#fff; color:#000; font-family:inherit; font-size:14px; font-weight:600; cursor:pointer; white-space:nowrap; }
  .wr-nl-{{ section.id }} .wr-nl__btn:hover { background:#e6e6e6; }
  .wr-nl-{{ section.id }} .wr-nl__msg { flex:0 0 100%; margin:0; font-size:13px; line-height:1.4; }
  @media (max-width:989px) {
    .wr-nl-{{ section.id }} .wr-nl__inner { grid-template-columns:1fr; gap:22px; padding:0 20px; }
    .wr-nl-{{ section.id }} .wr-nl__title { font-size:32px; }
  }
  @media (max-width:549px) {
    .wr-nl-{{ section.id }} .wr-nl__form { flex-direction:column; align-items:stretch; }
    .wr-nl-{{ section.id }} .wr-nl__form input[type=email] { width:100%; }
  }
{% endstyle %}

<section class="wr-nl-{{ section.id }}">
  <div class="wr-nl__inner">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="wr-nl__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="wr-nl__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="wr-nl__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div>
      {%- form 'customer', class: 'wr-nl__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.placeholder }}" aria-label="{{ section.settings.placeholder }}" value="{{ form.email }}">
        <button type="submit" class="wr-nl__btn">{{ section.settings.button_label }}</button>
        {%- if form.posted_successfully? -%}<p class="wr-nl__msg" role="status">{{ section.settings.success_text }}</p>{%- endif -%}
        {%- if form.errors -%}<p class="wr-nl__msg" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WR Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Walls Republic Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "First look at new collections." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join the list for early access to just-arrived designs, styling ideas and members-only offers." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "presets": [ { "name": "WR Newsletter" } ]
}
{% endschema %}
