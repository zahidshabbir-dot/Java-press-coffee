{%- assign sid = section.id -%}

{% style %}
  .jp-hd-{{ sid }} {
    --jp-hd-red: {{ section.settings.accent }};
    --jp-hd-text: {{ section.settings.text_color }};
    --jp-hd-sub-dark: {{ section.settings.dropdown_color }};
    background: #fff;
    font-family: 'Raleway', sans-serif;
    position: relative;
    z-index: 20;
  }

  .jp-hd-{{ sid }} * {
    box-sizing: border-box;
  }

  .jp-hd-{{ sid }} .jp-hd__inner {
    max-width: 1440px;
    height: 74px;
    margin: 0 auto;
    padding: 0 120px;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .jp-hd-{{ sid }} .jp-hd__logo {
    display: block;
    flex: 0 0 auto;
    line-height: 0;
    margin-right: auto;
  }

  .jp-hd-{{ sid }} .jp-hd__logo img {
    display: block;
    width: {{ section.settings.logo_width }}px;
    height: auto;
  }

  .jp-hd-{{ sid }} .jp-hd__nav {
    display: flex;
    align-items: center;
    gap: 44px;
    margin-right: 43px;
  }

  .jp-hd-{{ sid }} .jp-hd__link {
    color: var(--jp-hd-text);
    font-size: 15px;
    font-weight: 500;
    line-height: 35px;
    text-decoration: none;
    white-space: nowrap;
  }

  .jp-hd-{{ sid }} .jp-hd__link:hover,
  .jp-hd-{{ sid }} .jp-hd__link[aria-current='page'] {
    color: var(--jp-hd-red);
  }
  /* Dropdowns (filled from Shopify Navigation menus) */
  .jp-hd-{{ sid }} .jp-hd__item {
    position: relative;
  }

  .jp-hd-{{ sid }} .jp-hd__sub-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jp-hd-{{ sid }} .jp-hd__sub-list a {
    display: block;
    color: var(--jp-hd-text);
    font-size: 15px;
    font-weight: 400;
    line-height: 40px;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (min-width: 990px) {
    .jp-hd-{{ sid }} .jp-hd__item.has-sub > .jp-hd__link {
      position: relative;
    }

    .jp-hd-{{ sid }} .jp-hd__item.has-sub:hover > .jp-hd__link,
    .jp-hd-{{ sid }} .jp-hd__item.has-sub:focus-within > .jp-hd__link {
      color: var(--jp-hd-red);
      font-weight: 600;
    }

    .jp-hd-{{ sid }} .jp-hd__item.has-sub:hover > .jp-hd__link::after,
    .jp-hd-{{ sid }} .jp-hd__item.has-sub:focus-within > .jp-hd__link::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -9px;
      width: 5px;
      height: 5px;
      margin-left: -2.5px;
      border-radius: 50%;
      background: var(--jp-hd-red);
    }

    .jp-hd-{{ sid }} .jp-hd__sub {
      display: none;
      position: absolute;
      left: 50%;
      top: 100%;
      z-index: 30;
      padding-top: 12px;
      transform: translateX(-50%);
    }

    .jp-hd-{{ sid }} .jp-hd__item.has-sub:hover > .jp-hd__sub,
    .jp-hd-{{ sid }} .jp-hd__item.has-sub:focus-within > .jp-hd__sub {
      display: block;
    }

    .jp-hd-{{ sid }} .jp-hd__sub-list {
      min-width: 150px;
      border-radius: 6px;
      background: #fff;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      overflow: hidden;
    }

    .jp-hd-{{ sid }} .jp-hd__sub-list a {
      padding: 0 30px 0 22px;
      border-top: 1px solid #cdd9d6;
    }

    .jp-hd-{{ sid }} .jp-hd__sub-list li:first-child a {
      border-top: 0;
    }

    .jp-hd-{{ sid }} .jp-hd__sub-list:not(:hover) li:first-child a,
    .jp-hd-{{ sid }} .jp-hd__sub-list a:hover,
    .jp-hd-{{ sid }} .jp-hd__sub-list a:focus-visible {
      background: var(--jp-hd-sub-dark);
      color: #fff;
      font-weight: 500;
      outline: 0;
    }
  }

  .jp-hd-{{ sid }} .jp-hd__cart {
    position: relative;
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    margin: 0 32px 0 0;
    background: url('{{ 'icon-cart-jp.svg' | asset_url }}') center / 24px 24px no-repeat;
    text-decoration: none;
  }

  .jp-hd-{{ sid }} .jp-hd__cart .svg-wrapper {
    display: none;
  }

  .jp-hd-{{ sid }} .jp-hd__cart .cart-count-bubble {
    position: absolute;
    top: -8px;
    right: -10px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--jp-hd-red);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    line-height: 16px;
    text-align: center;
  }

  .jp-hd-{{ sid }} .jp-hd__cta {
    flex: 0 0 auto;
    width: 213.6px;
    height: 50px;
    padding: 0;
    border-radius: 5px;
    background: var(--jp-hd-red);
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    line-height: 50px;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .jp-hd-{{ sid }} .jp-hd__cta:hover {
    filter: brightness(0.93);
  }

  .jp-hd-{{ sid }} .jp-hd__burger {
    display: none;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--jp-hd-text);
    cursor: pointer;
  }

  .jp-hd-{{ sid }} .jp-hd__burger svg {
    width: 24px;
    height: 24px;
    display: block;
    margin: auto;
  }

  .jp-hd-{{ sid }} a:focus-visible,
  .jp-hd-{{ sid }} button:focus-visible {
    outline: 2px solid var(--jp-hd-text);
    outline-offset: 2px;
  }

  @media (max-width: 1199px) {
    .jp-hd-{{ sid }} .jp-hd__inner {
      padding: 0 40px;
    }

    .jp-hd-{{ sid }} .jp-hd__nav {
      gap: 24px;
      margin-right: 24px;
    }

    .jp-hd-{{ sid }} .jp-hd__cart {
      margin-right: 20px;
    }
  }

  .jp-hd-{{ sid }} .jp-hd__cta-m {
    display: none;
  }

  @media (max-width: 989px) {
    .jp-hd-{{ sid }} .jp-hd__inner {
      padding: 0 16px 0 14px;
      gap: 0;
      height: 52px;
    }

    .jp-hd-{{ sid }} .jp-hd__burger {
      display: block;
      order: 1;
      width: 36px;
      height: 36px;
      margin-right: 0;
      flex: 0 0 36px;
    }

    .jp-hd-{{ sid }} .jp-hd__logo {
      order: 2;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
    }

    .jp-hd-{{ sid }} .jp-hd__logo img {
      width: {{ section.settings.logo_width_mobile }}px;
    }

    .jp-hd-{{ sid }} .jp-hd__cart {
      order: 3;
      margin: 0 16px 0 auto;
    }

    .jp-hd-{{ sid }} .jp-hd__cta:not(.jp-hd__nav-cta) {
      order: 4;
      display: block;
      width: 82px;
      height: 38px;
      border-radius: 4px;
      font-size: 14px;
      line-height: 38px;
    }

    .jp-hd-{{ sid }} .jp-hd__cta-d {
      display: none;
    }

    .jp-hd-{{ sid }} .jp-hd__cta-m {
      display: inline;
    }

    .jp-hd-{{ sid }} .jp-hd__nav-cta {
      display: none;
    }

    .jp-hd-{{ sid }} .jp-hd__nav {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 200;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 0;
      background: #fff;
      overflow-y: auto;
    }

    .jp-hd-{{ sid }}.is-open .jp-hd__nav {
      display: flex;
    }

    .jp-hd-{{ sid }} .jp-hd__drawer-top {
      position: relative;
      display: flex;
      align-items: center;
      flex: 0 0 auto;
      height: 52px;
      padding: 0 14px;
      border-bottom: 1px solid #efefef;
    }

    .jp-hd-{{ sid }} .jp-hd__close {
      width: 36px;
      height: 36px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--jp-hd-text);
      cursor: pointer;
    }

    .jp-hd-{{ sid }} .jp-hd__close svg {
      display: block;
      width: 20px;
      height: 20px;
      margin: auto;
    }

    .jp-hd-{{ sid }} .jp-hd__drawer-logo {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      line-height: 0;
    }

    .jp-hd-{{ sid }} .jp-hd__drawer-logo img {
      display: block;
      width: {{ section.settings.logo_width_mobile }}px;
      height: auto;
    }

    .jp-hd-{{ sid }} .jp-hd__item {
      padding: 0 20px;
    }

    .jp-hd-{{ sid }} .jp-hd__link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      line-height: 52px;
      font-size: 16px;
      font-weight: 400;
      border: 0;
    }

    .jp-hd-{{ sid }} .jp-hd__item.has-sub > .jp-hd__link::after,
    .jp-hd-{{ sid }} .jp-hd__sub-list li.has-grand > a::after {
      content: '\2192';
      font-size: 18px;
      line-height: 1;
      color: var(--jp-hd-text);
    }

    .jp-hd-{{ sid }} .jp-hd__sub {
      display: none;
    }

    .jp-hd-{{ sid }} .jp-hd__sub-list a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0;
      line-height: 52px;
      font-size: 16px;
      font-weight: 400;
      border: 0;
    }

    .jp-hd-{{ sid }} .jp-hd__grand {
      display: none;
      margin: 0;
      padding: 0 0 8px 16px;
      list-style: none;
    }

    .jp-hd-{{ sid }} .jp-hd__grand a {
      line-height: 40px;
      font-size: 15px;
      color: #6b6b6b;
    }

    .jp-hd-{{ sid }} .jp-hd__sub-list li.is-open > .jp-hd__grand {
      display: block;
    }

    .jp-hd-{{ sid }} .jp-hd__sub-list li.is-open > a::after {
      transform: rotate(90deg);
    }
    /* second level: show only the tapped item, with a back row */
    .jp-hd-{{ sid }} .jp-hd__nav.has-active .jp-hd__item:not(.is-active),
    .jp-hd-{{ sid }} .jp-hd__nav.has-active .jp-hd__nav-cta {
      display: none;
    }

    .jp-hd-{{ sid }} .jp-hd__item.is-active > .jp-hd__link {
      justify-content: flex-start;
      gap: 10px;
      font-weight: 700;
    }

    .jp-hd-{{ sid }} .jp-hd__item.is-active > .jp-hd__link::after {
      content: none;
    }

    .jp-hd-{{ sid }} .jp-hd__item.is-active > .jp-hd__link::before {
      content: '\2190';
      font-size: 18px;
      font-weight: 400;
    }

    .jp-hd-{{ sid }} .jp-hd__item.is-active > .jp-hd__sub {
      display: block;
    }

    .jp-hd-{{ sid }} .jp-hd__drawer-foot {
      display: block;
      margin-top: auto;
      padding: 18px 20px 22px;
      background: #ececec;
      color: var(--jp-hd-text);
      font-size: 12px;
    }

    .jp-hd-{{ sid }} .jp-hd__acct {
      display: flex;
      align-items: center;
      gap: 8px;
      color: inherit;
      text-decoration: none;
      line-height: 20px;
    }

    .jp-hd-{{ sid }} .jp-hd__acct svg {
      width: 18px;
      height: 18px;
    }

    .jp-hd-{{ sid }} .jp-hd__loc {
      margin: 12px 0 16px;
    }

    .jp-hd-{{ sid }} .jp-hd__loc::after {
      content: '\25BE';
      margin-left: 8px;
      font-size: 10px;
    }

    .jp-hd-{{ sid }} .jp-hd__social {
      display: flex;
      align-items: center;
      gap: 14px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .jp-hd-{{ sid }} .jp-hd__social a {
      display: block;
      color: var(--jp-hd-text);
      line-height: 0;
    }

    .jp-hd-{{ sid }} .jp-hd__social svg {
      display: block;
      width: 18px;
      height: 18px;
    }
  }

  @media (min-width: 990px) {
    .jp-hd-{{ sid }} .jp-hd__nav-cta,
    .jp-hd-{{ sid }} .jp-hd__drawer-top,
    .jp-hd-{{ sid }} .jp-hd__drawer-foot,
    .jp-hd-{{ sid }} .jp-hd__grand {
      display: none;
    }
  }
{% endstyle %}

<header class="jp-hd-{{ sid }}" data-jp-hd>
  <div class="jp-hd__inner">
    <a class="jp-hd__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 440 | image_tag: width: section.settings.logo_width, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <nav class="jp-hd__nav" id="jp-hd-nav-{{ sid }}" aria-label="Main">
      <div class="jp-hd__drawer-top">
        <button type="button" class="jp-hd__close" aria-label="Close menu" data-jp-hd-close>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <a class="jp-hd__drawer-logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 440 | image_tag: width: section.settings.logo_width_mobile, alt: shop.name, loading: 'lazy' }}
          {%- else -%}
        {{ shop.name }}
          {%- endif -%}
        </a>
      </div>
      {%- assign main_menu = section.settings.menu -%}
      {%- if main_menu != blank and main_menu.links.size > 0 -%}
        {%- for link in main_menu.links -%}
          {%- assign has_sub = false -%}
          {%- if link.links.size > 0 -%}{%- assign has_sub = true -%}{%- endif -%}
          <div class="jp-hd__item{% if has_sub %} has-sub{% endif %}">
            <a class="jp-hd__link" href="{{ link.url }}"{% if link.current or link.child_current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if has_sub -%}
              <div class="jp-hd__sub">
                <ul class="jp-hd__sub-list">
                  {%- for child in link.links -%}
                    <li{% if child.links.size > 0 %} class="has-grand"{% endif %}>
                      <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a>
                      {%- if child.links.size > 0 -%}
                        <ul class="jp-hd__grand">
                          {%- for grand in child.links -%}<li><a href="{{ grand.url }}">{{ grand.title }}</a></li>{%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign sub_menu = block.settings.dropdown_menu -%}
          {%- assign has_sub = false -%}
          {%- if sub_menu != blank and sub_menu.links.size > 0 -%}{%- assign has_sub = true -%}{%- endif -%}
          <div class="jp-hd__item{% if has_sub %} has-sub{% endif %}" {{ block.shopify_attributes }}>
            <a class="jp-hd__link" href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
            {%- if has_sub -%}
              <div class="jp-hd__sub">
                <ul class="jp-hd__sub-list">
                  {%- for child in sub_menu.links -%}
                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="jp-hd__cta jp-hd__nav-cta" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      <div class="jp-hd__drawer-foot">
        <a class="jp-hd__acct" href="{{ routes.account_url }}">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="9.5" r="3" stroke="currentColor" stroke-width="1.8"/><path d="M6.5 18.5c1.2-2.4 3.100-3.500 5.500-3.500s4.300 1.100 5.500 3.500" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          {{ section.settings.login_label }}
        </a>
        <div class="jp-hd__loc">{{ localization.country.name }} | {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}</div>
        <ul class="jp-hd__social">
          <li><a href="{{ section.settings.social_instagram | default: '#' }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg></a></li>
          <li><a href="{{ section.settings.social_youtube | default: '#' }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M7 5h10a5 5 0 0 1 5 5v4a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5v-4a5 5 0 0 1 5-5zm3 4v6l5.200-3z"/></svg></a></li>
          <li><a href="{{ section.settings.social_facebook | default: '#' }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M5 2h14a3 3 0 0 1 3 3v14a3 3 0 0 1-3 3h-4.500v-7h2.300l.4-2.800h-2.700V9.400c0-.8.300-1.400 1.500-1.400H17V5.600c-.3 0-1.100-.1-2.100-.1-2.200 0-3.700 1.300-3.700 3.800v2H8.800V14h2.400v8H5a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3z"/></svg></a></li>
          <li><a href="{{ section.settings.social_pinterest | default: '#' }}" target="_blank" rel="noopener" aria-label="Pinterest"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M12 2a10 10 0 0 0-3.600 19.300c-.1-.8-.2-2 0-2.900l1.200-5s-.3-.6-.3-1.500c0-1.400.8-2.400 1.800-2.400.9 0 1.300.6 1.300 1.400 0 .9-.5 2.100-.8 3.300-.2 1 .5 1.800 1.500 1.800 1.800 0 3.200-1.900 3.200-4.600 0-2.400-1.700-4.100-4.200-4.100-2.900 0-4.600 2.200-4.600 4.400 0 .9.300 1.800.8 2.300.1.100.1.200.1.300l-.3 1.100c0 .2-.1.200-.3.100-1.300-.6-2.100-2.500-2.100-4 0-3.300 2.400-6.300 6.900-6.300 3.600 0 6.400 2.600 6.400 6 0 3.600-2.300 6.500-5.400 6.500-1.100 0-2.100-.6-2.400-1.200l-.7 2.500c-.2.900-.9 2.100-1.300 2.800A10 10 0 1 0 12 2z"/></svg></a></li>
          <li><a href="{{ section.settings.social_tiktok | default: '#' }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 3v11.500a3.700 3.700 0 1 1-3.700-3.700M14 3c.3 2.600 1.900 4.300 4.500 4.600" stroke="currentColor" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
        </ul>
      </div>
    </nav>

    <a class="jp-hd__cart" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="{{ 'templates.cart.cart' | t }}">
      <span class="svg-wrapper"></span>
      <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
      {%- if cart != empty -%}
        <div class="cart-count-bubble">
          {%- if cart.item_count < 100 -%}<span aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        </div>
      {%- endif -%}
    </a>

    {%- if section.settings.cta_label != blank -%}
      <a class="jp-hd__cta" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"><span class="jp-hd__cta-d">{{ section.settings.cta_label }}</span><span class="jp-hd__cta-m">{{ section.settings.cta_label_mobile | default: section.settings.cta_label }}</span></a>
    {%- endif -%}

    <button type="button" class="jp-hd__burger" aria-expanded="false" aria-controls="jp-hd-nav-{{ sid }}" aria-label="Menu" data-jp-hd-burger>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<script>
  (function () {
    let root = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-jp-hd')) return;
    let burger = root.querySelector('[data-jp-hd-burger]');
    let nav = root.querySelector('.jp-hd__nav');
    let close = root.querySelector('[data-jp-hd-close]');
    let mq = window.matchMedia('(max-width: 989px)');
    let savedOverflow = '';
    function setOpen(open) {
      let wasOpen = root.classList.contains('is-open');
      root.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      /* only undo the page scroll lock that this menu set itself */
      if (open && !wasOpen) {
        savedOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = 'hidden';
      } else if (!open && wasOpen) {
        document.documentElement.style.overflow = savedOverflow;
      }
      if (!open) {
        nav.classList.remove('has-active');
        let act = nav.querySelector('.jp-hd__item.is-active');
        if (act) act.classList.remove('is-active');
      }
    }
    burger.addEventListener('click', function () { setOpen(!root.classList.contains('is-open')); });
    close.addEventListener('click', function () { setOpen(false); burger.focus(); });
    nav.addEventListener('click', function (e) {
      if (!mq.matches) return;
      let link = e.target.closest('.jp-hd__item.has-sub > .jp-hd__link');
      if (link) {
        e.preventDefault();
        let item = link.parentNode;
        let on = item.classList.toggle('is-active');
        nav.classList.toggle('has-active', on);
        nav.scrollTop = 0;
        return;
      }
      let grand = e.target.closest('.jp-hd__sub-list li.has-grand > a');
      if (grand) {
        e.preventDefault();
        grand.parentNode.classList.toggle('is-open');
      }
    });
    /* document listeners remove themselves when the section is re-rendered (theme editor) */
    function onMq() {
      if (!root.isConnected) { mq.removeEventListener('change', onMq); return; }
      if (!mq.matches) setOpen(false);
    }
    function onKey(e) {
      if (!root.isConnected) { document.removeEventListener('keydown', onKey); return; }
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        burger.focus();
      }
    }
    mq.addEventListener('change', onMq);
    document.addEventListener('keydown', onKey);
  })();
</script>

