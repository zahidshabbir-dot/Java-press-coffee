{%- assign sid = section.id -%}
{%- capture cart_icon_svg -%}
  {%- render 'jp-icon-cart' -%}
{%- endcapture -%}

{{ 'jp-header.css' | asset_url | stylesheet_tag }}

<header
  class="jp-hd"
  data-jp-hd
  style="
    --jp-hd-red: {{ section.settings.accent }};
    --jp-hd-text: {{ section.settings.text_color }};
    --jp-hd-sub-dark: {{ section.settings.dropdown_color }};
    --jp-hd-logo-width: {{ section.settings.logo_width }}px;
    --jp-hd-logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
    --jp-hd-cart-icon: url('data:image/svg+xml;base64,{{ cart_icon_svg | strip | base64_encode }}');
  "
>
  <div class="jp-hd__inner">
    <a class="jp-hd__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 440 | image_tag: width: section.settings.logo_width, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <nav class="jp-hd__nav" id="jp-hd-nav-{{ sid }}" aria-label="Main">
      <div class="jp-hd__drawer-top">
        <button type="button" class="jp-hd__close" aria-label="Close menu" data-jp-hd-close>
          {% render 'jp-icon-close' %}
        </button>
        <a class="jp-hd__drawer-logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 440 | image_tag: width: section.settings.logo_width_mobile, alt: shop.name, loading: 'lazy' }}
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </a>
      </div>
      {%- assign main_menu = section.settings.menu -%}
      {%- if main_menu != blank and main_menu.links.size > 0 -%}
        {%- for link in main_menu.links -%}
          {%- assign has_sub = false -%}
          {%- if link.links.size > 0 -%}
            {%- assign has_sub = true -%}
          {%- endif -%}
          <div class="jp-hd__item{% if has_sub %} has-sub{% endif %}">
            <a class="jp-hd__link" href="{{ link.url }}"{% if link.current or link.child_current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if has_sub -%}
              <div class="jp-hd__sub">
                <ul class="jp-hd__sub-list">
                  {%- for child in link.links -%}
                    <li{% if child.links.size > 0 %} class="has-grand"{% endif %}>
                      <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a>
                      {%- if child.links.size > 0 -%}
                        <ul class="jp-hd__grand">
                          {%- for grand in child.links -%}
                            <li><a href="{{ grand.url }}">{{ grand.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign sub_menu = block.settings.dropdown_menu -%}
          {%- assign has_sub = false -%}
          {%- if sub_menu != blank and sub_menu.links.size > 0 -%}
            {%- assign has_sub = true -%}
          {%- endif -%}
          <div class="jp-hd__item{% if has_sub %} has-sub{% endif %}" {{ block.shopify_attributes }}>
            <a class="jp-hd__link" href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
            {%- if has_sub -%}
              <div class="jp-hd__sub">
                <ul class="jp-hd__sub-list">
                  {%- for child in sub_menu.links -%}
                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="jp-hd__cta jp-hd__nav-cta" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      <div class="jp-hd__drawer-foot">
        <a class="jp-hd__acct" href="{{ routes.account_url }}">
          {% render 'jp-icon-account' %}
          {{ section.settings.login_label }}
        </a>
        <div class="jp-hd__loc">{{ localization.country.name }} | {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}</div>
        <ul class="jp-hd__social">
          {%- if section.settings.social_instagram != blank -%}
            <li>
              <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                {%- render 'jp-icon-instagram' -%}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <li>
              <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
                {%- render 'jp-icon-youtube' -%}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <li>
              <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                {%- render 'jp-icon-facebook' -%}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.social_pinterest != blank -%}
            <li>
              <a href="{{ section.settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
                {%- render 'jp-icon-pinterest' -%}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <li>
              <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
                {%- render 'jp-icon-tiktok' -%}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </nav>

    <a class="jp-hd__cart" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="{{ 'templates.cart.cart' | t }}">
      <span class="svg-wrapper"></span>
      <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
      {%- if cart != empty -%}
        <div class="cart-count-bubble">
          {%- if cart.item_count < 100 -%}
            <span aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        </div>
      {%- endif -%}
    </a>

    {%- if section.settings.cta_label != blank -%}
      <a class="jp-hd__cta" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">
        <span class="jp-hd__cta-d">{{ section.settings.cta_label }}</span><span class="jp-hd__cta-m">{{ section.settings.cta_label_mobile | default: section.settings.cta_label }}</span>
      </a>
    {%- endif -%}

    <button type="button" class="jp-hd__burger" aria-expanded="false" aria-controls="jp-hd-nav-{{ sid }}" aria-label="Menu" data-jp-hd-burger>
      {% render 'jp-icon-burger' %}
    </button>
  </div>
</header>

<script src="{{ 'jp-header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "JP Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Top-level links show in the header; each link's sub-items become its hover dropdown. Manage it in Content → Menus. If empty, the menu links below are used."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Upload your logo. If empty, the store name is shown as text."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 100,
      "max": 220,
      "step": 2,
      "unit": "px",
      "default": 158
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width (mobile)",
      "min": 80,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Menu text color",
      "default": "#424242"
    },
    {
      "type": "color",
      "id": "dropdown_color",
      "label": "Dropdown highlight",
      "default": "#1b4540"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text",
      "default": "Shop now →"
    },
    {
      "type": "header",
      "content": "Mobile menu footer"
    },
    {
      "type": "text",
      "id": "login_label",
      "label": "Account link text",
      "default": "Login"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube link"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook link"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest link"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok link"
    },
    {
      "type": "text",
      "id": "cta_label_mobile",
      "label": "Button text (mobile)",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Menu link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "link_list",
          "id": "dropdown_menu",
          "label": "Dropdown menu",
          "info": "Only used when no Menu is chosen above."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JP Header",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "Learning Centre"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Our Coffee Solutions"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "About Us"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Blogs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
