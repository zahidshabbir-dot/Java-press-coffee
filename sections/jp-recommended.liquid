{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign limit = section.settings.products_count
  assign current_handle = ''
  if template.name == 'product'
    assign current_handle = product.handle
  endif
-%}

{{ 'jp-recommended.css' | asset_url | stylesheet_tag }}

<section
  class="jp-rc"
  style="
    --jp-rc-red: {{ section.settings.button_color }};
    --jp-rc-text: {{ section.settings.text_color }};
    --jp-rc-bg: {{ section.settings.bg }};
    --jp-rc-tile: {{ section.settings.tile_color }};
    --jp-rc-padding-top: {{ section.settings.padding_top }}px;
    --jp-rc-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jp-rc-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --jp-rc-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="jp-rc__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="jp-rc__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="jp-rc__grid">
      {%- assign shown = 0 -%}
      {%- for product in source.products -%}
        {%- if shown >= limit -%}
          {%- break -%}
        {%- endif -%}
        {%- if product.handle != current_handle -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="jp-rc__card">
            <a class="jp-rc__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    class: 'jp-rc__img',
                    alt: product.title,
                    loading: 'lazy',
                    widths: '300, 450, 600',
                    sizes: '(min-width: 990px) 25vw, 50vw'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'jp-rc__img' }}
              {%- endif -%}
              {%- if section.settings.show_badge -%}
                {%- if section.settings.badge != blank -%}
                  {{ section.settings.badge | image_url: width: 200 | image_tag: class: 'jp-rc__badge', alt: '', loading: 'lazy' }}
                {%- endif -%}
              {%- endif -%}
            </a>
            <a class="jp-rc__name" href="{{ product.url }}">{{ product.title }}</a>
            {%- if product.metafields.judgeme.badge != blank -%}
              <div class="jp-rc__rating jp-rc__rating--jm">{{ product.metafields.judgeme.badge }}</div>
            {%- endif -%}
            <div class="jp-rc__price">
              <span class="jp-rc__now">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <s class="jp-rc__was">{{ product.compare_at_price | money }}</s>
              {%- endif -%}
            </div>
            {%- if product.has_only_default_variant and product.available -%}
              {%- form 'product', product, class: 'jp-rc__form' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="jp-rc__btn">{{ section.settings.button_label }}</button>
              {%- endform -%}
            {%- elsif product.available -%}
              <a class="jp-rc__btn" href="{{ product.url }}">{{ section.settings.button_options_label }}</a>
            {%- else -%}
              <span class="jp-rc__btn jp-rc__btn--off">{{ section.settings.sold_out_label }}</span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "JP Recommended",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended For You"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to use all products. The product being viewed is skipped."
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "button_options_label",
      "label": "Button text (products with options)",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Badge image",
      "info": "Upload the badge image. Nothing shows until you upload one."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#e3e3e3"
    },
    {
      "type": "color",
      "id": "tile_color",
      "label": "Image background",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#424242"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#ef4444"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "JP Recommended"
    }
  ]
}
{% endschema %}
