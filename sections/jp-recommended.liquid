{%- liquid
  assign source_collection = section.settings.collection | default: collections.all
  assign max_products_shown = section.settings.products_count
  assign current_product_handle = ''
  if template.name == 'product'
    assign current_product_handle = product.handle
  endif
  assign shown_products_count = 0
-%}

{%- assign badge_markup = '' -%}
{%- if section.settings.show_badge and section.settings.badge != blank -%}
  {%- capture badge_markup -%}
    {{
      section.settings.badge
      | image_url: width: 200
      | image_tag: class: 'jp-rc__badge', alt: '', loading: 'lazy'
    }}
  {%- endcapture -%}
{%- endif -%}

{{ 'jp-product-card.css' | asset_url | stylesheet_tag }}
{{ 'jp-recommended.css' | asset_url | stylesheet_tag }}

<section
  class="jp-rc"
  style="
    --jp-rc-red: {{ section.settings.button_color }};
    --jp-rc-text: {{ section.settings.text_color }};
    --jp-rc-bg: {{ section.settings.bg }};
    --jp-rc-tile: {{ section.settings.tile_color }};
    --jp-rc-padding-top: {{ section.settings.padding_top }}px;
    --jp-rc-padding-bottom: {{ section.settings.padding_bottom }}px;
    --jp-rc-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --jp-rc-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="jp-rc__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="jp-rc__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="jp-rc__grid">
      {%- for source_product in source_collection.products -%}
        {%- if shown_products_count >= max_products_shown -%}
          {%- break -%}
        {%- endif -%}
        {%- if source_product.handle != current_product_handle -%}
          {%- assign shown_products_count = shown_products_count | plus: 1 -%}
          {% render 'jp-product-card',
            product: source_product,
            prefix: 'jp-rc',
            badge_markup: badge_markup,
            button_label: section.settings.button_label,
            options_label: section.settings.button_options_label,
            sold_out_label: section.settings.sold_out_label
          %}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "JP Recommended",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended For You"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to use all products. The product being viewed is skipped."
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "button_options_label",
      "label": "Button text (products with options)",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "info": "The badge only shows once a badge image is uploaded below.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Badge image",
      "info": "Shown in the top right corner of every product image."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#e3e3e3"
    },
    {
      "type": "color",
      "id": "tile_color",
      "label": "Image background",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#424242"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#ef4444"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "JP Recommended"
    }
  ]
}
{% endschema %}
