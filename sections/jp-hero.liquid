{%- assign background_image = section.settings.bg_image -%}
{%- assign background_image_mobile = section.settings.bg_image_mobile -%}
{%- assign hero_image = section.settings.image -%}

{%- assign script_font_url = section.settings.script_font_url | strip | remove: "'" | remove: '"' -%}

{{ 'jp-hero.css' | asset_url | stylesheet_tag }}

{%- if script_font_url != blank -%}
  {%- comment -%}
    The font file is uploaded in Shopify admin (Content > Files) and its link is pasted in
    the section settings, so no font is stored in the theme code.
  {%- endcomment -%}
  {% style %}
    @font-face {
      font-family: 'JP Hero Script';
      src: url('{{ script_font_url }}');
      font-display: swap;
    }
  {% endstyle %}
{%- endif -%}

<section
  class="jp-hero"
  style="
    --jp-hero-bg: {{ section.settings.bg }};
    --jp-hero-accent: {{ section.settings.accent_color }};
    {%- if script_font_url != blank %}
      --jp-hero-script-font: 'JP Hero Script', cursive;
    {%- endif %}
    --jp-hero-red: {{ section.settings.button_color }};
    --jp-hero-dark: {{ section.settings.button_secondary_color }};
    --jp-hero-height: {{ section.settings.height }}px;
    --jp-hero-image-align: {{ section.settings.image_align }};
    --jp-hero-image-width: {{ section.settings.image_width }}px;
    {%- if background_image != blank %}
      --jp-hero-bg-image: url('{{ background_image | image_url: width: 2880 }}');
    {%- endif %}
    {%- if background_image_mobile != blank %}
      --jp-hero-bg-image-mobile: url('{{ background_image_mobile | image_url: width: 1000 }}');
    {%- endif %}
  "
>
  <div class="jp-hero__inner">
    <div class="jp-hero__content">
      <h1 class="jp-hero__title">
        {{- section.settings.title_before }}
        {%- if section.settings.title_script != blank %}
          <span class="jp-hero__script">{{ section.settings.title_script }}</span>
        {%- endif -%}
        {%- if section.settings.title_after != blank -%}
          <br>{{ section.settings.title_after }}
        {%- endif -%}
      </h1>

      {%- if section.settings.text != blank -%}
        <div class="jp-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- assign primary_button_url = section.settings.button_url
        | default: routes.all_products_collection_url
      -%}
      {%- if section.settings.button_label != blank -%}
        <a class="jp-hero__btn jp-hero__btn--primary" href="{{ primary_button_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank and section.settings.button_2_url != blank -%}
        <a class="jp-hero__btn jp-hero__btn--secondary" href="{{ section.settings.button_2_url }}">
          {{- section.settings.button_2_label -}}
        </a>
      {%- endif -%}
    </div>

    <div class="jp-hero__visual">
      {%- if hero_image != blank -%}
        {%- assign hero_image_alt = hero_image.alt | default: section.settings.title_before -%}
        {%- capture hero_image_sizes -%}
          (min-width: 750px) {{ section.settings.image_width }}px, min(calc(100vw - 32px), 340px)
        {%- endcapture -%}
        {{
          hero_image
          | image_url: width: 1280
          | image_tag:
            class: 'jp-hero__product',
            alt: hero_image_alt,
            widths: '340, 450, 680, 900, 1280',
            sizes: hero_image_sizes,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JP Hero",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Heading start",
      "default": "Your"
    },
    {
      "type": "text",
      "id": "title_script",
      "label": "Script (accent) word",
      "default": "Perfect"
    },
    {
      "type": "text",
      "id": "script_font_url",
      "label": "Script word font file (link)",
      "info": "Upload the font file (.woff2) in Content > Files, copy its link and paste it here. Leave empty to use the heading font."
    },
    {
      "type": "text",
      "id": "title_after",
      "label": "Heading second line",
      "default": "Coffee Routine!"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover your tailored at home coffee products & routine as we are your <strong>100% FREE Coffee Concierge</strong>!</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button text",
      "default": "Browse all products →"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Primary button link",
      "default": "/collections/all",
      "info": "Leave empty to link to all products."
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button text",
      "default": "Take your free survey now →"
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "Secondary button link",
      "info": "The button is hidden when this is empty."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Shown next to the text. A transparent PNG about 900 px wide works best."
    },
    {
      "type": "select",
      "id": "image_align",
      "label": "Product image position",
      "default": "flex-end",
      "options": [
        {
          "value": "flex-start",
          "label": "Left (near the text)"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Product image width",
      "min": 280,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 450
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "info": "Covers the whole banner. Recommended size 2880 × 1240 px."
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image (mobile)",
      "info": "Used on phones. If empty, the desktop image is used."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#075e58"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (script word)",
      "default": "#deb126"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Primary button",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "button_secondary_color",
      "label": "Secondary button",
      "default": "#064a46"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Minimum height",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 620
    }
  ],
  "presets": [
    {
      "name": "JP Hero"
    }
  ]
}
{% endschema %}
