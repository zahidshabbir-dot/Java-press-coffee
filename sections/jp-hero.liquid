{{ 'jp-hero.css' | asset_url | stylesheet_tag }}

<section
  class="jp-hero"
  data-jp-hero
  style="--jp-hero-bg: {{ section.settings.bg }}; --jp-hero-accent: {{ section.settings.accent_color }}; --jp-hero-red: {{ section.settings.button_color }}; --jp-hero-dark: {{ section.settings.button_secondary_color }}; --jp-hero-height: {{ section.settings.height }}px; --jp-hero-image-align: {{ section.settings.image_align }}; --jp-hero-image-width: {{ section.settings.image_width }}px;
    {%- if section.settings.bg_image != blank %} --jp-hero-bg-image: url('{{ section.settings.bg_image | image_url: width: 2880 }}');{% endif -%}
    {%- if section.settings.bg_image_mobile != blank %} --jp-hero-bg-image-mobile: url('{{ section.settings.bg_image_mobile | image_url: width: 1000 }}');{% endif -%}
  "
>
  <div class="jp-hero__inner">
    <div class="jp-hero__content">
      <h1 class="jp-hero__title">
        {{- section.settings.title_before }}
        {%- if section.settings.title_script != blank %} <span class="jp-hero__script">{{ section.settings.title_script }}</span>{% endif -%}
        {%- if section.settings.title_after != blank %}<br>{{ section.settings.title_after }}{% endif -%}
      </h1>

      {%- if section.settings.text != blank -%}
        <div class="jp-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="jp-hero__btn jp-hero__btn--primary" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="jp-hero__btn jp-hero__btn--secondary" href="{{ section.settings.button_2_url | default: '#' }}">{{ section.settings.button_2_label }}</a>
      {%- endif -%}
    </div>

    <div class="jp-hero__visual">
      {%- if section.settings.image != blank -%}
        {%- assign hero_alt = section.settings.image.alt | default: section.settings.title_before -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'jp-hero__product', alt: hero_alt, loading: 'eager', fetchpriority: 'high' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JP Hero",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "title_before",
      "label": "Heading start",
      "default": "Your"
    },
    {
      "type": "text",
      "id": "title_script",
      "label": "Script (accent) word",
      "default": "Perfect"
    },
    {
      "type": "text",
      "id": "title_after",
      "label": "Heading second line",
      "default": "Coffee Routine!"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover your tailored at home coffee products & routine as we are your <strong>100% FREE Coffee Concierge</strong>!</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button text",
      "default": "Browse all products  →"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button text",
      "default": "Take your free survey now  →"
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Upload the product image."
    },
    {
      "type": "select",
      "id": "image_align",
      "label": "Product image position",
      "default": "flex-end",
      "options": [
        {
          "value": "flex-start",
          "label": "Left (near the text)"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Product image width",
      "min": 280,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 450
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "info": "Upload the banner image."
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image (mobile)",
      "info": "Used on phones. If empty, the desktop image is used."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#075e58"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (script word)",
      "default": "#deb126"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Primary button",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "button_secondary_color",
      "label": "Secondary button",
      "default": "#064a46"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Minimum height",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 620
    }
  ],
  "presets": [
    {
      "name": "JP Hero"
    }
  ]
}
{% endschema %}
