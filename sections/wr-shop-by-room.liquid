<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

{% style %}
  .wr-sbr-{{ section.id }} { background:{{ section.settings.bg }}; font-family:'Instrument Sans',sans-serif; padding:30px 0; }
  .wr-sbr-{{ section.id }} * { box-sizing:border-box; }
  .wr-sbr-{{ section.id }} .wr-sbr__inner { max-width:1360px; margin:0 auto; padding:0 40px; }
  .wr-sbr-{{ section.id }} .wr-sbr__head { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; }
  .wr-sbr-{{ section.id }} .wr-sbr__eyebrow { margin:0; font-size:14px; line-height:normal; font-weight:600; color:#6b6b6b; letter-spacing:1.75px; text-transform:uppercase; }
  .wr-sbr-{{ section.id }} .wr-sbr__title { margin:0; padding-top:4px; font-family:'Instrument Sans',sans-serif; font-size:32px; line-height:36px; font-weight:600; color:#1a1a1a; text-transform:none; letter-spacing:0; }
  .wr-sbr-{{ section.id }} .wr-sbr__all { flex:0 0 auto; padding-bottom:2px; border-bottom:1px solid #000; font-size:14px; line-height:normal; font-weight:600; color:#1a1a1a; text-decoration:none; white-space:nowrap; }
  .wr-sbr-{{ section.id }} .wr-sbr__all:hover { opacity:0.65; }
  .wr-sbr-{{ section.id }} .wr-sbr__grid { display:grid; grid-template-columns:1.6fr 1fr 1fr; grid-auto-rows:{{ section.settings.row_height }}px; gap:14px; padding-top:26px; }
  .wr-sbr-{{ section.id }} .wr-sbr__tile { position:relative; display:block; overflow:hidden; background:#efece6; color:#1a1a1a; text-decoration:none; min-width:0; }
  .wr-sbr-{{ section.id }} .wr-sbr__tile:first-child { grid-row:1 / span 2; }
  .wr-sbr-{{ section.id }} .wr-sbr__tile img, .wr-sbr-{{ section.id }} .wr-sbr__tile svg.placeholder-svg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; transition:transform .5s ease; }
  .wr-sbr-{{ section.id }} .wr-sbr__tile:hover img { transform:scale(1.03); }
  .wr-sbr-{{ section.id }} .wr-sbr__chip { position:absolute; left:14px; bottom:14px; max-width:calc(100% - 28px); display:flex; align-items:center; gap:10px; padding:10px 14px; background:#fff; }
  .wr-sbr-{{ section.id }} .wr-sbr__chip-title { font-size:15px; line-height:normal; font-weight:600; color:#1a1a1a; white-space:nowrap; }
  .wr-sbr-{{ section.id }} .wr-sbr__chip-sub { font-size:13px; line-height:normal; color:#6b6b6b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .wr-sbr-{{ section.id }} .wr-sbr__chip svg { width:16px; height:16px; flex:0 0 16px; color:#1a1a1a; }
  @media (max-width:989px) {
    .wr-sbr-{{ section.id }} .wr-sbr__inner { padding:0 20px; }
    .wr-sbr-{{ section.id }} .wr-sbr__grid { grid-template-columns:1fr 1fr; grid-auto-rows:200px; }
    .wr-sbr-{{ section.id }} .wr-sbr__tile:first-child { grid-column:1 / span 2; grid-row:span 2; }
  }
  @media (max-width:749px) {
    .wr-sbr-{{ section.id }} { padding:24px 0; }
    .wr-sbr-{{ section.id }} .wr-sbr__title { font-size:28px; line-height:32px; }
    .wr-sbr-{{ section.id }} .wr-sbr__grid { grid-auto-rows:170px; gap:10px; padding-top:20px; }
    .wr-sbr-{{ section.id }} .wr-sbr__tile:first-child { grid-row:span 2; }
    .wr-sbr-{{ section.id }} .wr-sbr__chip { left:8px; bottom:8px; max-width:calc(100% - 16px); padding:8px 10px; gap:6px; }
    .wr-sbr-{{ section.id }} .wr-sbr__chip-title { font-size:13px; }
    .wr-sbr-{{ section.id }} .wr-sbr__chip-sub { display:none; }
  }
{% endstyle %}

<section class="wr-sbr-{{ section.id }}">
  <div class="wr-sbr__inner">
    <div class="wr-sbr__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="wr-sbr__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="wr-sbr__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}<a class="wr-sbr__all" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>

    <div class="wr-sbr__grid">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- assign room_title = block.settings.title | default: col.title -%}
        {%- assign room_url = block.settings.link | default: col.url -%}
        {%- assign room_img = block.settings.image | default: col.image -%}
        <a class="wr-sbr__tile" href="{{ room_url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if room_img != blank -%}
            {{ room_img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 990px) 40vw, 100vw', alt: room_title }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="wr-sbr__chip">
            <span class="wr-sbr__chip-title">{{ room_title }}</span>
            {%- if block.settings.subtitle != blank -%}<span class="wr-sbr__chip-sub">{{ block.settings.subtitle }}</span>{%- endif -%}
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WR Shop by room",
  "max_blocks": 7,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Find the right fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Room" },
    { "type": "text", "id": "link_label", "label": "Link label (top right)", "default": "All rooms" },
    { "type": "url", "id": "link", "label": "Link (top right)" },
    { "type": "range", "id": "row_height", "label": "Row height", "min": 180, "max": 340, "step": 10, "unit": "px", "default": 250 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Name", "default": "Living Room" },
        { "type": "text", "id": "subtitle", "label": "Small text", "default": "Statement walls" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "collection", "id": "collection", "label": "Collection (optional)", "info": "Used for the link, name and image if those are left empty." }
      ]
    }
  ],
  "presets": [
    {
      "name": "WR Shop by room",
      "blocks": [
        { "type": "room", "settings": { "title": "Living Room", "subtitle": "Statement walls" } },
        { "type": "room", "settings": { "title": "Bedroom", "subtitle": "Calm & cozy" } },
        { "type": "room", "settings": { "title": "Bathroom", "subtitle": "Moisture-friendly picks" } },
        { "type": "room", "settings": { "title": "Nursery & Kids", "subtitle": "Playful patterns" } },
        { "type": "room", "settings": { "title": "Commercial", "subtitle": "Hotels, offices, retail" } }
      ]
    }
  ]
}
{% endschema %}
