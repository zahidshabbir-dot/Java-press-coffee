{{ 'jp-best-sellers.css' | asset_url | stylesheet_tag }}

<section
  class="jp-bs"
  style="
    --jp-bs-red: {{ section.settings.accent }};
    --jp-bs-text: {{ section.settings.text_color }};
    --jp-bs-tile: {{ section.settings.tile_bg }};
    --jp-bs-tab: {{ section.settings.tab_color }};
    --jp-bs-bg: {{ section.settings.bg }};
    --jp-bs-padding-top: {{ section.settings.padding_top }}px;
    --jp-bs-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-jp-bs
>
  <div class="jp-bs__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="jp-bs__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- assign tab_shown = false -%}
    <div class="jp-bs__tabs" role="tablist">
      {%- for i in (1..4) -%}
        {%- assign ckey = 'collection_' | append: i -%}
        {%- assign lkey = 'tab_' | append: i -%}
        {%- assign c = section.settings[ckey] -%}
        {%- if c != blank -%}
          {%- assign selected = 'false' -%}
          {%- unless tab_shown -%}
            {%- assign selected = 'true' -%}
            {%- assign tab_shown = true -%}
          {%- endunless -%}
          <button
            type="button"
            class="jp-bs__tab"
            role="tab"
            data-jp-bs-tab="{{ i }}"
            aria-selected="{{ selected }}"
          >
            {{- section.settings[lkey] | default: c.title -}}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="jp-bs__carousel">
      <button
        type="button"
        class="jp-bs__arrow jp-bs__arrow--prev"
        data-jp-bs-prev
        aria-label="Previous products"
      >
        {% render 'jp-icon-chevron', direction: 'prev' %}
      </button>

      <div class="jp-bs__track" data-jp-bs-track>
        {%- for i in (1..4) -%}
          {%- assign ckey = 'collection_' | append: i -%}
          {%- assign c = section.settings[ckey] -%}
          {%- if c != blank -%}
            {%- for product in c.products limit: section.settings.products_per_tab -%}
              <article class="jp-bs__card" data-jp-bs-card data-tab="{{ i }}">
                <a
                  class="jp-bs__media"
                  href="{{ product.url }}"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 600
                      | image_tag:
                        class: 'jp-bs__img',
                        alt: product.title,
                        loading: 'lazy',
                        widths: '300, 450, 600',
                        sizes: '(min-width: 990px) 25vw, 50vw'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'jp-bs__img' }}
                  {%- endif -%}
                  {%- if section.settings.show_badge -%}
                    {%- if section.settings.badge != blank -%}
                      {{
                        section.settings.badge
                        | image_url: width: 200
                        | image_tag: class: 'jp-bs__badge', alt: '', loading: 'lazy'
                      }}
                    {%- endif -%}
                  {%- endif -%}
                </a>
                <a class="jp-bs__name" href="{{ product.url }}">{{ product.title }}</a>
                {%- if product.metafields.judgeme.badge != blank -%}
                  <div class="jp-bs__rating jp-bs__rating--jm">
                    {{- product.metafields.judgeme.badge -}}
                  </div>
                {%- endif -%}
                <div class="jp-bs__price">
                  <span class="jp-bs__now">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <s class="jp-bs__was">{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                </div>
                {%- if product.has_only_default_variant and product.available -%}
                  {%- form 'product', product, class: 'jp-bs__form' -%}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ product.selected_or_first_available_variant.id }}"
                    >
                    <button type="submit" class="jp-bs__btn">
                      {{- section.settings.button_label -}}
                    </button>
                  {%- endform -%}
                {%- elsif product.available -%}
                  <a class="jp-bs__btn" href="{{ product.url }}">
                    {{- section.settings.button_options_label -}}
                  </a>
                {%- else -%}
                  <span class="jp-bs__btn jp-bs__btn--off">
                    {{- section.settings.sold_out_label -}}
                  </span>
                {%- endif -%}
              </article>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <button
        type="button"
        class="jp-bs__arrow jp-bs__arrow--next"
        data-jp-bs-next
        aria-label="Next products"
      >
        {% render 'jp-icon-chevron', direction: 'next' %}
      </button>
    </div>

    {%- unless tab_shown -%}
      {%- if request.design_mode -%}
        <p class="jp-bs__empty">
          Choose a collection for Tab 1 in the section settings to show products.
        </p>
      {%- endif -%}
    {%- endunless -%}
    <div class="jp-bs__dots" data-jp-bs-dots></div>
  </div>
</section>

<script src="{{ 'jp-best-sellers.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "JP Best sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try Our Best Sellers"
    },
    {
      "type": "header",
      "content": "Tabs",
      "info": "Each tab shows the products of one collection. Leave a collection empty to hide that tab."
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Tab 1 collection"
    },
    {
      "type": "text",
      "id": "tab_1",
      "label": "Tab 1 name",
      "info": "Leave empty to use the collection title."
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Tab 2 collection"
    },
    {
      "type": "text",
      "id": "tab_2",
      "label": "Tab 2 name",
      "info": "Leave empty to use the collection title."
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Tab 3 collection"
    },
    {
      "type": "text",
      "id": "tab_3",
      "label": "Tab 3 name",
      "info": "Leave empty to use the collection title."
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Tab 4 collection"
    },
    {
      "type": "text",
      "id": "tab_4",
      "label": "Tab 4 name",
      "info": "Leave empty to use the collection title."
    },
    {
      "type": "range",
      "id": "products_per_tab",
      "label": "Products per tab",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart button text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "button_options_label",
      "label": "Button text (products with options)",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Badge image",
      "info": "Upload the badge image. Nothing shows until you upload one."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "tile_bg",
      "label": "Image tile background",
      "default": "#d9d9d9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#424242"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color (button)",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "tab_color",
      "label": "Active tab underline",
      "default": "#af272f"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 82
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 46
    }
  ],
  "presets": [
    {
      "name": "JP Best sellers"
    }
  ]
}
{% endschema %}
